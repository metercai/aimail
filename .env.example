# AgentMail environment variables
# Copy to .env in the repo root — the aimail CLI loads it automatically,
# so common values (URL, key/code, manager) don't need CLI flags every time.
# Priority: CLI flag > shell env > .env > built-in default.

# ── Required (pick one) ─────────────────────────────────────────

# Path A: existing admin_key
AIMAIL_ADMIN_KEY=

# Path B: product activation code (new system)
AIMAIL_PRODUCT_CODE=

# ── Gateway URL ─────────────────────────────────────────────────

# aimail-gateway URL (auto-detects localhost:38080 by default)
# AIMAIL_URL=http://127.0.0.1:38080
# AIMAIL_URL=https://amail.token.tm

# ── Domain ──────────────────────────────────────────────────────

# Mail domain (leave empty to select interactively)
# AIMAIL_DOMAIN=admin.local

# ── Shared-domain system identifier ─────────────────────────────

# System name for shared-domain activation (3-8 chars, [a-z0-9_-],
# lowercase letter start). Lets integration scripts run non-interactively.
# AIMAIL_SYSTEM_NAME=team01

# ── Snapshots ───────────────────────────────────────────────────

# Save raw email snapshots locally (yes/no, default yes)
# AIMAIL_SAVE_SNAPSHOTS=yes

# ── Manager Address ─────────────────────────────────────────────

# Email address of the human manager for notifications
# AIMAIL_MANAGER_ADDRESS=admin@example.com

# ── Webhook ─────────────────────────────────────────────────────

# Webhook bridge address (ip:port, skips mode prompt when set)
# AIMAIL_WEBHOOK_HOST=192.168.1.100:38081
