{
  "_comment": "AIMail CLI 平台注册表 — CLI 侧唯一平台知识源(Phase 1: 检测/指针/枚举/别名/注册委托)。适配实现全在 SDK:pysdk(hermes/deer-flow)+ tssdk 包(openclaw 宿主命令/dsh/pi node 入口)。CLI 读本表调度,零平台协议。",
  "order": [
    "pi",
    "dsh",
    "hermes",
    "openclaw",
    "deerflow"
  ],
  "platforms": {
    "pi": {
      "detect": {
        "dir_name": ".pi",
        "markers": [
          "agent"
        ]
      },
      "pointer": {
        "kind": "root",
        "file": ".agentmail"
      },
      "agents": {
        "kind": "fixed",
        "names": [
          "pi"
        ]
      },
      "aliases": [],
      "register": {
        "kind": "node_entry",
        "default_name": "pi",
        "node_path": "{home}/agent/npm/node_modules/pi-aimail/dist/register-cli.js",
        "args": [
          "--system-id",
          "{sid}",
          "--manager",
          "{manager}"
        ],
        "fail_hint": "pi-aimail 扩展未就绪——先 `pi install npm:pi-aimail` 装扩展再注册"
      },
      "home_dir": ".pi",
      "install_steps": [
        {
          "kind": "print",
          "text": "pi platform: ensure the pi-aimail extension (auto; skipped when present) + register the agent:"
        },
        {
          "kind": "spawn",
          "argv": [
            "pi",
            "install",
            "npm:pi-aimail"
          ],
          "skip_if": {
            "argv": [
              "pi",
              "list"
            ],
            "match": "pi-aimail"
          },
          "on_missing": "fail",
          "fail_hint": "`pi` executable not found (platform detected but host CLI missing?)",
          "on_error": "warn",
          "warn_hint": "pi-aimail extension install failed (check network/registry) — after fixing, rerun `aimail reset -s {sid}`",
          "ok_text": "pi-aimail extension installed (npm registry latest stable; takes effect after the pi session restarts)",
          "skipped_text": "pi-aimail extension already present (install skipped)"
        },
        {
          "kind": "register_default",
          "when": {
            "cfg_complete": true
          },
          "on_error": "warn",
          "warn_hint": "pi agent registration failed (see above) — rerun `aimail reset -s {sid}` (or `aimail address -s {sid} -a pi`) once the extension is in place"
        },
        {
          "kind": "warn",
          "text": "pi registration skipped (config incomplete — retry after activation/install, or run `aimail address -a pi`)",
          "when": {
            "cfg_complete": false
          }
        },
        {
          "kind": "print",
          "text": "  pi: inbound listener lives with the pi session lifecycle (restart the session to apply)"
        }
      ],
      "uninstall_steps": [
        {
          "kind": "rm_pointer",
          "path": "{home}/.agentmail",
          "ok_text": "removed pointer {home}/.agentmail"
        },
        {
          "kind": "rm_dir",
          "path": "{home}/skills/agentmail",
          "ok_text": "removed skill {home}/skills/agentmail"
        },
        {
          "kind": "rm_dir",
          "path": "{home}/skills/aimail",
          "ok_text": "removed legacy skill {home}/skills/aimail"
        },
        {
          "kind": "print",
          "text": "  pi: 扩展移除 = pi 宿主侧移除 pi-aimail 扩展"
        }
      ],
      "health_checks": [
        {
          "id": "pointer",
          "kind": "pointer_match",
          "path": "{user_home}/.pi/.agentmail",
          "ok_text": ".pi pointer matches system",
          "fail_text": ".pi pointer missing/mismatch"
        }
      ]
    },
    "dsh": {
      "detect": {
        "dir_name": ".dsh",
        "markers": [
          "profiles",
          "storages"
        ]
      },
      "pointer": {
        "kind": "root",
        "file": ".agentmail"
      },
      "agents": {
        "kind": "fixed",
        "names": [
          "agent"
        ]
      },
      "aliases": [],
      "register": {
        "kind": "node_entry",
        "default_name": "agent",
        "node_path": "{home}/profiles/*/node_modules/dsh-aimail/lib/register-cli.js",
        "args": [
          "--system-id",
          "{sid}",
          "--manager",
          "{manager}",
          "--preset",
          "mail"
        ],
        "fail_hint": "dsh-aimail 插件未就绪——先 `dsh plugin --profile web add dsh-aimail` 装插件再注册"
      },
      "home_dir": ".dsh",
      "install_steps": [
        {
          "kind": "spawn",
          "argv": [
            "dsh",
            "plugin",
            "--profile",
            "web",
            "add",
            "dsh-aimail"
          ],
          "on_missing": "fail",
          "fail_hint": "`dsh` CLI not found — build/install deepseek-harness first (e.g. cd ~/deepseek-harness && cargo build --release && ln -sf \"$PWD/target/release/dsh\" ~/.local/bin/dsh), then re-run aimail install",
          "on_error": "warn",
          "warn_hint": "dsh plugin add aimail 失败(检查 aimail npm 包发布与网络)",
          "ok_text": "aimail 插件已安装(dsh bundle 层挂载)",
          "env": {
            "DSH_HOME": "{home}"
          }
        },
        {
          "kind": "print",
          "text": "  dsh: 绑定 = 创建 dsh session(mail preset)后自动 auto-bind;"
        },
        {
          "kind": "print",
          "text": "        CLI 侧注册:`aimail address -s <sid> -a agent`"
        }
      ],
      "uninstall_steps": [
        {
          "kind": "print",
          "text": "  dsh: 共享配置已清理;dsh 侧卸载 mail 插件(mail/mail-inbound/tool-mail)+ 删 preset 即可"
        }
      ],
      "health_checks": []
    },
    "hermes": {
      "detect": {
        "markers": [
          "hermes-agent",
          "profiles"
        ]
      },
      "pointer": {
        "kind": "root_or_profiles",
        "file": ".agentmail"
      },
      "agents": {
        "kind": "profiles_plus_default",
        "profiles": "profiles"
      },
      "aliases": [
        "default"
      ],
      "register": {
        "kind": "python_module",
        "default_name": "default",
        "module": "aimail_hermes",
        "fn": "_auto_register_email",
        "profile": {
          "kind": "root_or_named",
          "root_when": [
            "default",
            "{home_name}"
          ]
        },
        "pythonpath": [
          "pysdk/hermes"
        ]
      },
      "home_dir": ".hermes",
      "install_steps": [
        {
          "kind": "spawn",
          "argv": [
            "{home}/hermes-agent/venv/bin/python",
            "-m",
            "pip",
            "install",
            "-q",
            "aimailsdk"
          ],
          "when": {
            "path_exists": "{home}/hermes-agent/venv/bin/python",
            "runtime_not": "docker"
          },
          "on_error": "warn",
          "warn_hint": "venv pip install aimailsdk exit {rc}(webhook 适配运行时缺失?)"
        },
        {
          "kind": "spawn",
          "argv": [
            "docker",
            "exec",
            "{container}",
            "{container_home}/.venv/bin/python",
            "-m",
            "ensurepip",
            "--upgrade"
          ],
          "when": {
            "runtime": "docker"
          },
          "on_missing": "fail",
          "fail_hint": "docker CLI not found — --container mode requires docker on the host PATH",
          "on_error": "warn",
          "warn_hint": "ensurepip 失败(容器名/路径)——venv 可能已含 pip 或不可写",
          "ok_text": "pip ensured in container {container}"
        },
        {
          "kind": "spawn",
          "argv": [
            "docker",
            "exec",
            "{container}",
            "{container_home}/.venv/bin/python",
            "-m",
            "pip",
            "install",
            "-q",
            "aimailsdk"
          ],
          "when": {
            "runtime": "docker"
          },
          "on_missing": "fail",
          "fail_hint": "docker CLI not found — --container mode requires docker on the host PATH",
          "on_error": "warn",
          "warn_hint": "docker exec pip 装 aimailsdk 失败(容器名/容器内路径/网络)——register/sdk 文件步骤已由 sdk_install 落盘, 可人工 `docker exec <c> <home>/.venv/bin/python -m pip install aimailsdk` 后重跑 install",
          "ok_text": "aimailsdk installed inside container {container}"
        },
        {
          "kind": "sdk_install",
          "target": "hermes",
          "fn": "install_hermes",
          "ok_text": "hermes SDK install done(重启 hermes gateway 生效)"
        },
        {
          "kind": "register_default",
          "warn_hint": "hermes 主 agent 注册失败(见上)——稍后 reset 重试"
        },
        {
          "kind": "register_all",
          "ok_text": "hermes --all-agents 全量注册完成",
          "warn_hint": "hermes 全量注册失败(可 reset --all-agents 重试)"
        },
        {
          "kind": "print",
          "when": {
            "runtime": "docker"
          },
          "text": "  docker: 重启宿主 = `docker restart {container}`; 容器重建后必须重跑 aimail install -H <home> … --container {container}(幂等)"
        }
      ],
      "uninstall_steps": [
        {
          "kind": "sdk_uninstall",
          "target": "hermes",
          "fn": "uninstall_hermes"
        },
        {
          "kind": "spawn",
          "argv": [
            "{home}/hermes-agent/venv/bin/python",
            "-m",
            "pip",
            "uninstall",
            "-y",
            "aimailsdk"
          ],
          "when": {
            "path_exists": "{home}/hermes-agent/venv/bin/python"
          },
          "on_error": "warn",
          "warn_hint": "pip uninstall aimailsdk exit {rc}(webhook 适配运行时残留)"
        }
      ],
      "health_checks": [
        {
          "id": "patch-webhook",
          "kind": "file_contains",
          "path": "{home}/hermes-agent/gateway/platforms/webhook.py",
          "marker": "PREPROCESS_REGISTRY",
          "ok_text": "webhook.py patched (PREPROCESS_REGISTRY present)",
          "fail_text": "webhook.py NOT patched or missing"
        },
        {
          "id": "patch-profiles",
          "kind": "file_contains_alt",
          "path": "{home}/hermes-agent/hermes_cli/profiles.py",
          "alt": "{home}/hermes-agent/cli/profiles.py",
          "marker": "AimailGateway",
          "ok_text": "profiles.py patched (AimailGateway hook present)",
          "fail_text": "profiles.py NOT patched or missing"
        },
        {
          "id": "skills",
          "kind": "file_exists_any",
          "paths": [
            "{home}/skills/agentmail/SKILL.md",
            "{home}/profiles/*/skills/agentmail/SKILL.md"
          ],
          "ok_text": "at least one profile has skills/agentmail/SKILL.md",
          "fail_text": "no profile has skills/agentmail/SKILL.md"
        },
        {
          "id": "toolsets",
          "kind": "yaml_toolsets",
          "configs": [
            "{home}/config.yaml",
            "{home}/profiles/*/config.yaml"
          ],
          "ok_text": "platform_toolsets contains agentmail",
          "fail_text": "platform_toolsets lacks agentmail"
        }
      ],
      "register_all": {
        "kind": "python_script",
        "python": "pysdk/hermes/register_profiles.py",
        "args": [],
        "env": {
          "AIMAIL_SYSTEM_ID": "{sid}"
        },
        "fail_hint": "register_profiles 执行失败(见上输出)"
      }
    },
    "openclaw": {
      "detect": {
        "markers": [
          "openclaw.json"
        ]
      },
      "pointer": {
        "kind": "root",
        "file": ".agentmail"
      },
      "agents": {
        "kind": "glob_dir",
        "dir": "agents"
      },
      "aliases": [
        "main"
      ],
      "register": {
        "kind": "host_command",
        "default_name": "main",
        "argv": [
          "openclaw",
          "aimail",
          "register",
          "--email",
          "{email}",
          "--system-id",
          "{sid}"
        ],
        "manager_arg": [
          "--manager",
          "{manager}"
        ],
        "fail_hint": "先安装 openclaw-aimail 插件(`openclaw plugins install openclaw-aimail --force --accept-capabilities` → 重启 gateway),`openclaw aimail register` 命令由插件提供"
      },
      "home_dir": ".openclaw",
      "install_steps": [
        {
          "kind": "print",
          "text": "openclaw platform: ensure the openclaw-aimail plugin (auto; skipped when present) + register the agent (single agent: `aimail address -s SID -a main`):"
        },
        {
          "kind": "spawn",
          "argv": [
            "openclaw",
            "plugins",
            "install",
            "openclaw-aimail@latest",
            "--force",
            "--accept-capabilities"
          ],
          "skip_if": {
            "argv": [
              "openclaw",
              "plugins",
              "list"
            ],
            "match": "aimail"
          },
          "on_missing": "fail",
          "fail_hint": "`openclaw` executable not found (platform detected but host CLI missing?)",
          "on_error": "warn",
          "warn_hint": "openclaw-aimail plugin install failed (check network/registry) — after fixing, rerun `aimail reset -s {sid}`; keep `@latest` in the spec: a bare name is shadowed by a same-named local dir in cwd",
          "ok_text": "openclaw-aimail plugin installed (npm registry latest stable; takes effect after the gateway restarts)",
          "skipped_text": "openclaw-aimail plugin already present (install skipped)"
        },
        {
          "kind": "print",
          "text": "  restart the openclaw gateway to activate the plugin: `openclaw gateway install` (or `restart`)"
        },
        {
          "kind": "print",
          "text": "  register: openclaw aimail register --system-id {sid} (or `aimail address -s {sid} -a main`)",
          "when": {
            "sid_set": true
          }
        },
        {
          "kind": "print",
          "text": "  register: `openclaw aimail register` (once pointer/system ready) or `aimail address -a main`",
          "when": {
            "sid_set": false
          }
        },
        {
          "kind": "register_default",
          "warn_hint": "openclaw main agent registration failed (see above) — rerun `aimail reset -s {sid}` once the plugin is in place"
        },
        {
          "kind": "register_all",
          "ok_text": "openclaw --all-agents registration complete",
          "warn_hint": "openclaw register-all failed (rerun `aimail reset -s {sid} --all-agents` once the plugin is in place)"
        }
      ],
      "uninstall_steps": [
        {
          "kind": "print",
          "text": "  openclaw: 对接全在 TS 插件(openclaw-aimail)——插件移除 = openclaw 宿主侧卸载 + `openclaw aimail deregister`;共享系统数据已在上段(网关注销+本机数据)清理"
        }
      ],
      "health_checks": [
        {
          "id": "plugin-installed",
          "kind": "command_match",
          "argv": [
            "openclaw",
            "plugins",
            "list"
          ],
          "match": "openclaw-aimail",
          "fallback_glob": "{user_home}/.openclaw/npm/projects/openclaw-aimail*",
          "ok_text": "openclaw-aimail 插件在位(openclaw plugins list)",
          "fail_text": "openclaw-aimail 插件未安装",
          "fix": "aimail install --home <openclaw home>(自动装;已装则跳过)或 openclaw plugins install openclaw-aimail@latest --force --accept-capabilities"
        },
        {
          "id": "skills",
          "kind": "file_exists",
          "path": "{user_home}/.openclaw/skills/agentmail/SKILL.md",
          "ok_text": "skills/agentmail/SKILL.md present",
          "fail_text": "skills/agentmail/SKILL.md missing",
          "fix": "插件自带 skill(openclaw-aimail resources)——检查插件 enabled:openclaw plugins list"
        }
      ],
      "register_all": {
        "kind": "host_command",
        "argv": [
          "openclaw",
          "aimail",
          "register-all",
          "--system-id",
          "{sid}"
        ],
        "fail_hint": "openclaw-aimail 需 ≥0.1.10(register-all 命令)"
      }
    },
    "deerflow": {
      "detect": {
        "markers": [
          "backend/app/gateway"
        ]
      },
      "pointer": {
        "kind": "root",
        "file": ".agentmail"
      },
      "agents": {
        "kind": "fixed_with_pointer",
        "names": [
          "agent"
        ]
      },
      "aliases": [],
      "register": {
        "kind": "python_script",
        "default_name": "agent",
        "python": "pysdk/deer-flow/manage.py",
        "args": [
          "register",
          "--system-id",
          "{sid}",
          "--agent",
          "{agent}"
        ],
        "fail_hint": "deer-flow manage.py 注册器失败——检查 pysdk/deer-flow 模块与系统配置"
      },
      "payload_refs": [
        "{home}/extensions_config.json"
      ],
      "home_dir": ".deer-flow",
      "install_steps": [
        {
          "kind": "sdk_install",
          "target": "deerflow",
          "fn": "install_deerflow",
          "ok_text": "deerflow SDK install done"
        },
        {
          "kind": "spawn",
          "argv": [
            "bash",
            "{sdk}/deer-flow/install-skill.sh"
          ],
          "env": {
            "AIMAIL_SYSTEM_ID": "{sid}"
          },
          "on_error": "warn",
          "warn_hint": "deer-flow install-skill.sh exit {rc}"
        },
        {
          "kind": "spawn",
          "argv": [
            "bash",
            "{sdk}/deer-flow/install-mcp.sh"
          ],
          "env": {
            "AIMAIL_SYSTEM_ID": "{sid}"
          },
          "on_error": "warn",
          "warn_hint": "deer-flow install-mcp.sh exit {rc}"
        },
        {
          "kind": "register_default",
          "warn_hint": "deerflow 主 agent 注册失败(见上)——稍后 reset 重试"
        },
        {
          "kind": "register_all",
          "ok_text": "deerflow --all-agents 全量注册完成",
          "warn_hint": "deerflow 全量注册失败(可 reset --all-agents 重试)"
        }
      ],
      "uninstall_steps": [
        {
          "kind": "sdk_uninstall",
          "target": "deerflow",
          "fn": "uninstall_deerflow"
        },
        {
          "kind": "print",
          "text": "  deerflow: skill/mcp 宿主装配残留可用宿主侧管理清理"
        }
      ],
      "health_checks": [
        {
          "id": "patch-app",
          "kind": "file_contains_alt",
          "path": "{home}/backend/app/gateway/app.py",
          "alt": "{home}/app/gateway/app.py",
          "marker": "aimail_inbound",
          "ok_text": "app.py patched (aimail_inbound router present)",
          "fail_text": "app.py NOT patched or missing"
        }
      ],
      "register_all": {
        "kind": "python_script",
        "python": "pysdk/deer-flow/manage.py",
        "args": [
          "register",
          "--all",
          "--system-id",
          "{sid}"
        ],
        "fail_hint": "manage.py register --all 失败(见上输出)"
      },
      "agent_check_remote": true
    }
  }
}
