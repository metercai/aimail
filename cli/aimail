PLATFORM_ROOTS = [
    ("hermes",   ".hermes"),
    ("openclaw", ".openclaw"),
    ("deerflow", ".deer-flow"),
    ("dsh",      ".dsh"),
    ("pi",       ".pi"),
]

def _pointer_sid_for(platform: str) -> str:
    """Read the platform's .agentmail pointer system_id ('' = none)."""
    if platform == "openclaw":
        ptr = HOME / ".openclaw" / ".agentmail"
    elif platform == "deerflow":
        ptr = HOME / ".deer-flow" / ".agentmail"
    elif platform == "pi":
        ptr = HOME / ".pi" / ".agentmail"
    elif platform == "dsh":
        ptr = HOME / ".dsh" / ".agentmail"
    else:
        ptr = HOME / ".hermes" / ".agentmail"
        if not ptr.is_file():
            profiles = HOME / ".hermes" / "profiles"
            if profiles.is_dir():
                for pp in sorted(profiles.glob("*/.agentmail")):
                    if pp.is_file():
                        ptr = pp
                        break
    try:
        return json.loads(ptr.read_text()).get("system_id", "") if ptr.is_file() else ""
    except Exception:
        return ""

def _all_pointer_sids() -> dict:
    """sid -> [platform names pointing at it]."""
    out: dict = {}
    for plat, _root in PLATFORM_ROOTS:
        sid = _pointer_sid_for(plat)
        if sid:
            out.setdefault(sid, []).append(plat)
    return out

def _platform_root_exists(platform: str) -> bool:
    root = HOME / dict(PLATFORM_ROOTS)[platform]
    if not root.exists():
        return False
    return detect_platform_from_home(root) == platform


def _gateway_cfg_path(sid: str) -> Path:
    """Path to the system's gateway config; migrates legacy filename once."""
    p = SYSTEMS_DIR / sid / "aimail_gateway.json"
    legacy = SYSTEMS_DIR / sid / "agentmail_gateway.json"
    if legacy.is_file() and not p.is_file():
        try:
            legacy.rename(p)
            os.chmod(p, 0o600)
        except Exception:
            pass
    return p



def cmd_stats(args) -> int:
