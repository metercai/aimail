def _addr_clean(email: str) -> str:
    """地址 → 目录键(与 aimail_base._clean_agent_dir_name 一致)。"""
    return re.sub(r"[^\w.\-]", "_", email, flags=re.ASCII)


def _mail_stats(email: str) -> tuple[int, int]:
    """该 agent 邮件目录的 (收件数, 字节数)。"""
    mail_dir = AIMAIL_HOME / "mail" / _addr_clean(email)
    count, size = 0, 0
    if mail_dir.is_dir():
        for root, _dirs, files in os.walk(mail_dir):
            for fn in files:
                try:
                    size += (Path(root) / fn).stat().st_size
                except OSError:
                    pass
                if fn.startswith("in-") and fn.endswith(".json"):
                    count += 1
    return count, size


def _fmt_size(n: int) -> str:
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.1f} {unit}" if unit != "B" else f"{n} B"
        n /= 1024
    return f"{n} B"


