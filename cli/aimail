def _resolve_renew_target(args) -> tuple[str, str, str]:
    """解析 renew 目标系统 → (system_id, gateway_url, admin_key)。

    --system-id 显式指定;省略时:唯一系统自动选定,多系统报错列出。
    """
    load_core()
    from gateway_api import load_gateway_config
    candidates: list[str] = []
    if SYSTEMS_DIR.is_dir():
        for d in sorted(SYSTEMS_DIR.iterdir()):
            if d.is_dir() and (d / "agentmail_gateway.json").is_file():
                candidates.append(d.name)
    sid = args.system_id
    if not sid:
        if not candidates:
            _fail("no aimail systems configured; use --system-id")
        if len(candidates) == 1:
            sid = candidates[0]
        else:
            _fail(f"multiple systems installed: {', '.join(candidates)}; use --system-id")
    elif sid not in candidates:
        _fail(f"system not found locally: {sid} (installed: {', '.join(candidates) or 'none'})")
    cfg = load_gateway_config(sid) or {}
    gw_url = args.gateway_url or cfg.get("gateway_url") or _env_val("AIMAIL_URL", "https://amail.token.tm")
    admin_key = cfg.get("admin_key") or ""
    if not admin_key:
        _fail(f"no admin_key in agentmail_gateway.json for {sid}")
    return sid, gw_url, admin_key


def cmd_renew(args) -> int:
    """续期系统(消耗产品激活码)或只读到期状态。

    --code 给出 → POST /api/v1/admin/renew-system(叠加式: max(now,到期)+新码 validity)。
    --code 省略 → GET /api/v1/quotas 只读展示 expires_at/配额。
    """
    sid, gw_url, admin_key = _resolve_renew_target(args)
    from aimail_tools import _GatewayClient
    client = _GatewayClient(gw_url, admin_key)

    if getattr(args, "status", False) or not getattr(args, "code", None):
        r = client._request("GET", "/api/v1/quotas")
        if not isinstance(r, dict) or r.get("status") != 200:
            _fail(f"quotas query failed: {r}")
        exp = r.get("expires_at") or "unlimited"
        print(f"  system {sid}")
        print(f"    product: {r.get('product_id')} · validity: {r.get('validity_days')} days")
        print(f"    expires_at: {exp}")
        # ≤3 天预警(与 stats 同规则)
        if r.get("expires_at"):
            try:
                from datetime import datetime, timezone
                dt = datetime.fromisoformat(str(r["expires_at"]).replace("Z", "+00:00"))
                days = (dt - datetime.now(timezone.utc)).days
                if days <= 3:
                    _warn(f"expires in {days} day(s) — renew with: aimail renew --system-id {sid} --code <activation-code>")
                else:
                    print(f"    {days} day(s) remaining")
            except Exception:
                pass
        print(f"    quotas: domains {r.get('max_domains')} · addresses {r.get('max_addresses')} · "
              f"daily {r.get('max_daily_emails')} · attachments {r.get('max_attachments')}")
        return 0

    code = str(args.code).strip()
    print(f"  renewing system {sid} with activation code {code[:12]}...")
    r = client._request("POST", "/api/v1/admin/renew-system", body={"code": code})
    if not isinstance(r, dict) or r.get("status") not in (200, "renewed", "200"):
        _fail(f"renew failed: {r}")
    _ok(f"renewed: expires_at {r.get('expires_at')}")
    q = r.get("quota") or {}
    if q:
        print(f"    merged quotas: domains {q.get('max_domains')} · addresses {q.get('max_addresses')} · "
              f"daily {q.get('max_daily_emails')} · attachments {q.get('max_attachments')}")
    print(f"    product: {r.get('product_id')} ({r.get('product_name')})")
    return 0


def cmd_stats(args) -> int:
    """本机 aimail 对接状态(只读):系统列表 + agent 实例 + 邮件统计。"""
    if not SYSTEMS_DIR.is_dir() or not any(SYSTEMS_DIR.iterdir()):
        print("  no aimail systems configured on this machine")
        return 0
    print("  Systems installed:")
    total_agents = 0
    for sid_dir in sorted(SYSTEMS_DIR.iterdir()):
        if not sid_dir.is_dir():
            continue
        gw_path = sid_dir / "agentmail_gateway.json"
        if not gw_path.is_file():
            continue
        sid = sid_dir.name
        try:
            gw = json.loads(gw_path.read_text())
        except Exception:
            gw = {}
        system_home = gw.get("system_home", "")
        platform = detect_platform_from_home(Path(system_home)) if system_home else ""
        if platform in ("", "unknown"):
            platform = "unknown"
        agents = []
        for sub in sorted(sid_dir.iterdir()):
            aj = sub / "agentmail.json"
            if not aj.is_file():
                continue
            try:
                d = json.loads(aj.read_text())
                email = d.get("email", "")
            except Exception:
                continue
            if not email:
                continue
            n, sz = _mail_stats(email)
            agents.append({
                "email": email,
                "manager": d.get("manager_address") or gw.get("manager_address", ""),
                "emails": n,
                "size": sz,
            })
        total_agents += len(agents)
        expiry_line = ""
        try:
            load_core()
            from aimail_tools import _GatewayClient
            gwurl = gw.get("gateway_url") or ""
            key = gw.get("admin_key") or ""
            if gwurl and key:
                qr = _GatewayClient(gwurl, key)._request("GET", "/api/v1/quotas")
                if isinstance(qr, dict) and qr.get("status") == 200 and qr.get("expires_at"):
                    from datetime import datetime, timezone
                    dt = datetime.fromisoformat(str(qr["expires_at"]).replace("Z", "+00:00"))
                    days = (dt - datetime.now(timezone.utc)).days
                    mark = f"  {YELLOW}⚠ EXPIRES in {days}d{NC}" if days <= 3 else f"  (expires in {days}d)"
                    expiry_line = f"   expires: {qr['expires_at'][:10]}{mark}"
                elif isinstance(qr, dict) and qr.get("status") == 403:
                    expiry_line = f"   {RED}EXPIRED/SUSPENDED{NC} — renew: aimail renew --system-id {sid} --code <activation-code>"
        except Exception:
            expiry_line = "   expires: (query failed)"
        print(f"    {sid}   [{platform}]   agents: {len(agents)}{expiry_line}")
    print(f"  Agents ({total_agents}):")
    for sid_dir in sorted(SYSTEMS_DIR.iterdir()):
        if not sid_dir.is_dir():
            continue
        if not (sid_dir / "agentmail_gateway.json").is_file():
            continue
        try:
            gw = json.loads((sid_dir / "agentmail_gateway.json").read_text())
        except Exception:
            gw = {}
        system_home = gw.get("system_home", "")
        platform = detect_platform_from_home(Path(system_home)) if system_home else "?"
        if platform in ("", "unknown"):
            platform = "?"
        for sub in sorted(sid_dir.iterdir()):
            aj = sub / "agentmail.json"
            if not aj.is_file():
                continue
            try:
                d = json.loads(aj.read_text())
                email = d.get("email", "")
            except Exception:
                continue
            if not email:
                continue
            n, sz = _mail_stats(email)
            mgr = d.get("manager_address") or gw.get("manager_address", "") or "-"
            print(f"    {email}   [{platform}]")
            print(f"        received: {n} emails · storage: {_fmt_size(sz)} · manager: {mgr}")
    return 0


def _confirm(msg: str, args) -> bool:
    if getattr(args, "yes", False):
        return True
    try:
        ans = input(f"  {msg} [y/N] ").strip().lower()
    except EOFError:
        return False
    return ans in ("y", "yes")


def _uninstall_hermes(system_home: Path, sid: str) -> None:
    """Hermes 侧清理:指针 / skill / tools / toolsets / webhook patch / config。"""
    if not system_home.is_dir():
        _warn(f"hermes home 不存在: {system_home}(跳过平台侧清理)")
        return
    profiles = system_home / "profiles"
    # 1. 指针 + skill(逐 profile,仅 sid 匹配指针)
    if profiles.is_dir():
        for p in sorted(profiles.iterdir()):
            if not p.is_dir():
                continue
            ptr = p / ".agentmail"
            if ptr.is_file():
                try:
                    if json.loads(ptr.read_text()).get("system_id") == sid:
                        ptr.unlink()
                        _ok(f"removed pointer {ptr}")
                except Exception:
                    pass
            sk = p / "skills" / "aimail"
            if sk.is_dir():
                shutil.rmtree(sk)
                _ok(f"removed skill {sk}")
            # config.yaml:platform_toolsets 移除 aimail 条目
            cfg = p / "config.yaml"
            if cfg.is_file():
                try:
                    content = cfg.read_text()
                    new = re.sub(r"^[ \t]*-[ \t]*aimail[ \t]*\r?$\n?", "", content, flags=re.M)
                    if new != content:
                        cfg.write_text(new)
                        _ok(f"config toolset cleaned {cfg}")
                except Exception as e:
                    _warn(f"config.yaml clean failed: {e}")
            # webhook 订阅路由
            subs = p / "webhook_subscriptions.json"
            if subs.is_file():
                try:
                    data = json.loads(subs.read_text())
                    if isinstance(data, dict) and "aimail-inbound" in data:
                        del data["aimail-inbound"]
                        subs.write_text(json.dumps(data, indent=2, ensure_ascii=False))
                        _ok(f"webhook route removed {subs}")
                except Exception as e:
                    _warn(f"webhook_subscriptions clean failed: {e}")
    # 2. venv pip 卸载(SDK 运行时载荷;patch 撤销与 tools 清理已由
    #    SDK uninstall 完成——谁打谁撤)
    ha = system_home / "hermes-agent"
    if ha.is_dir():
        venv_py = ha / "venv" / "bin" / "python"
        if venv_py.is_file():
            try:
                r = subprocess.run(
                    [str(venv_py), "-m", "pip", "uninstall", "-y", "aimail"],
                    capture_output=True, text=True, timeout=60)
                if r.returncode == 0:
                    _ok("uninstalled aimail (venv pip)")
                else:
                    _warn(f"pip uninstall aimail: {(r.stderr or r.stdout).strip()[:120]}")
            except Exception as e:
                _warn(f"pip uninstall aimail failed: {e}")


def _uninstall_openclaw(sid: str) -> None:
    """OpenClaw 侧清理:指针 / skill / MCP / cron / wrapper。"""
    oc_home = HOME / ".openclaw"
    if not oc_home.is_dir():
        _warn(f"openclaw home 不存在: {oc_home}(跳过平台侧清理)")
        return
    ptr = oc_home / ".agentmail"
    if ptr.is_file():
        try:
            if json.loads(ptr.read_text()).get("system_id") == sid:
                ptr.unlink()
                _ok(f"removed pointer {ptr}")
        except Exception:
            pass
    sk = oc_home / "skills" / "aimail"
    if sk.is_dir():
        shutil.rmtree(sk)
        _ok(f"removed skill {sk}")
    # MCP server 段
    cfg = oc_home / "openclaw.json"
    if cfg.is_file():
        try:
            data = json.loads(cfg.read_text())
            servers = (data.get("mcp") or {}).get("servers") or {}
            if "amail" in servers:
                del servers["amail"]
                cfg.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
                _ok("removed amail MCP server from openclaw.json")
        except Exception as e:
            _warn(f"openclaw.json clean failed: {e}")
    # cron:amail-poll
    try:
        out = subprocess.check_output(["openclaw", "cron", "list", "--json"],
                                      text=True, timeout=15, stderr=subprocess.DEVNULL)
        import json as _json
        items = _json.loads(out)
        items = items if isinstance(items, list) else items.get("crons", items.get("jobs", []))
        for c in items:
            if c.get("name") == "amail-poll":
                subprocess.call(["openclaw", "cron", "remove", str(c.get("id"))],
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                _ok("removed amail-poll cron")
    except Exception:
        pass
    # wrapper + bashrc PATH 行
    w = oc_home / "bin" / "openclaw"
    if w.exists():
        w.unlink()
        _ok(f"removed wrapper {w}")
    bashrc = HOME / ".bashrc"
    if bashrc.exists():
        content = bashrc.read_text()
        new = re.sub(
            r"\n# openclaw agents lifecycle wrapper \(amail integration\)\nexport PATH=\"\$HOME/\.openclaw/bin:\$PATH\"",
            "", content)
        if new != content:
            bashrc.write_text(new)
            _ok("removed openclaw wrapper PATH from .bashrc")


def cmd_uninstall(args) -> int:
    """卸载:与 install 对等,消除 aimail 在 agent 系统上的配置。"""
    system_home = Path(args.home).expanduser() if args.home else Path()
    sid, platform = resolve_system_id(system_home, args.system_id or "")
    if not sid:
        _fail("uninstall 需要 --system-id(或用 --home 定位平台)")
    # 幂等:系统数据与指针都不存在 → 视为已卸载
    if not (SYSTEMS_DIR / sid).is_dir() and not any(
            _ptr_sid(_platform_ptr(p)) == sid for p in ("openclaw", "hermes")):
        print(f"  system {sid} not installed (already uninstalled?)")
        return 0
    if not platform:
        platform = resolve_platform(system_home)
    if not platform:
        _fail(f"无法确定平台(system {sid})——用 --home 指定平台根")

    print(f"  uninstall system={sid} platform={platform}")
    if not _confirm(f"确认卸载 system {sid} 的 aimail 对接(含网关注销与本机数据)?", args):
        print("  cancelled")
        return 1

    gw = {}
    gw_path = SYSTEMS_DIR / sid / "agentmail_gateway.json"
    if gw_path.is_file():
        try:
            gw = json.loads(gw_path.read_text())
        except Exception:
            pass

    # 1. 网关注销(每 agent,公共链:api-key → domain → whitelist)
    load_core()
    try:
        from aimail_tools import _GatewayClient
        from aimail_base import deregister_agent_email
        sid_dir = SYSTEMS_DIR / sid
        if sid_dir.is_dir():
            for sub in sorted(sid_dir.iterdir()):
                aj = sub / "agentmail.json"
                if not aj.is_file():
                    continue
                try:
                    d = json.loads(aj.read_text())
                    email = d.get("email", "")
                except Exception:
                    continue
                if not email:
                    continue
                if gw.get("gateway_url") and gw.get("admin_key"):
                    try:
                        client = _GatewayClient(gw["gateway_url"], gw["admin_key"])
                        st = deregister_agent_email(client, sid, email,
                                                    manager_address=d.get("manager_address", ""))
                        _ok(f"gateway deregister {email} (api-key={st.get('api_key')} "
                            f"domain={st.get('domain')} whitelist={st.get('whitelist')})")
                    except Exception as e:
                        _warn(f"gateway deregister {email} failed: {e}")
                else:
                    _warn(f"no gateway credentials — skip gateway deregister for {email}")
    except ImportError as e:
        _warn(f"tools import failed: {e}(跳过网关注销)")

    # 2. 平台侧清理
    if platform == "hermes":
        # SDK 撤销自己打的 patch + 清 hermes-agent 内工具(谁打谁撤)
        sdk_home = system_home if system_home.is_dir() else Path(gw.get("system_home", ""))
        _sdk_uninstall("hermes", sdk_home, sid)
        # CLI:profile 级本地配置清理(指针/skill/config 工具集/路由)+ venv pip 卸载
        _uninstall_hermes(sdk_home, sid)
    elif platform == "openclaw":
        _uninstall_openclaw(sid)
    elif platform == "pi":
        # 共享系统配置由通用段清理(网关注销);pi 侧仅 pointer + skill 目录
        ptr = HOME / ".pi" / ".agentmail"
        if ptr.is_file():
            try:
                if json.loads(ptr.read_text()).get("system_id") == sid:
                    ptr.unlink()
                    _ok(f"removed pointer {ptr}")
            except Exception:
                pass
        sk = HOME / ".pi" / "skills" / "aimail"
        if sk.is_dir():
            shutil.rmtree(sk, ignore_errors=True)
            _ok(f"removed skill {sk}")
        print("  pi: 扩展移除 = pi 宿主侧移除 pi-aimail 扩展")
    else:  # deerflow
        # SDK 撤销 app.py patch + 删运行时 bundle
        sdk_home = system_home if system_home.is_dir() else Path(gw.get("system_home", ""))
        _sdk_uninstall("deerflow", sdk_home, sid)
        print("  deerflow: skill/mcp 宿主装配残留可用宿主侧管理清理")
    if platform == "dsh":
        # dsh:绑定文件由通用段清理;dsh 侧插件卸载(dsh-mail-* 插件移除)为 dsh 操作
        print("  dsh: 共享配置已清理;dsh 侧卸载 mail 插件(mail/mail-inbound/tool-mail)+ 删 preset 即可")

    # 3. 本机数据
    sid_dir = SYSTEMS_DIR / sid
    if sid_dir.is_dir():
        for sub in sid_dir.glob("*/agentmail.json"):
            try:
                email = json.loads(sub.read_text()).get("email", "")
            except Exception:
                continue
            if email:
                mdir = AIMAIL_HOME / "mail" / _addr_clean(email)
                if mdir.is_dir():
                    shutil.rmtree(mdir)
                    _ok(f"removed mail data {mdir}")
        shutil.rmtree(sid_dir)
        _ok(f"removed system data {sid_dir}")
    raw = AIMAIL_HOME / ".system_raw_key" / f"{sid}_admin.key"
    if raw.is_file():
        raw.unlink()
        _ok(f"removed raw key {raw}")

    print(f"  uninstall done for {sid}")
    return 0

