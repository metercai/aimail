GREEN, RED, YELLOW, NC = "\033[0;32m", "\033[0;31m", "\033[1;33m", "\033[0m"


def _ok(msg): print(f"  {GREEN}✓{NC} {msg}")
def _warn(msg): print(f"  {YELLOW}⚠{NC} {msg}")
def _fail(msg):
    print(f"  {RED}✗{NC} {msg}")
    sys.exit(1)


def _load_env() -> None:
    """Load machine-level + repo .env into os.environ (never overrides existing vars).

    Priority: shell environment > ~/.aimail/.env (machine-level, authoritative
    for bootstrapped installs) > repo .env (dev fallback) > CLI default.
    """
    home_env = HOME / ".aimail" / ".env"
    for candidate in (home_env, SCRIPTS_DIR.parent / ".env", SCRIPTS_DIR / ".env"):
        if not candidate.is_file():
            continue
        try:
            for line in candidate.read_text().splitlines():
                s = line.strip()
                if not s or s.startswith("#") or "=" not in s:
                    continue
                k, _, v = s.partition("=")
                k = k.strip()
                v = v.strip().strip('"').strip("'")
                if k and k not in os.environ:
                    os.environ[k] = v
        except Exception:
            pass


def _env_val(key: str, fallback: str = "") -> str:
    """env var value (from .env or shell) with fallback."""
    return os.environ.get(key, "") or fallback


