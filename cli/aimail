def cmd_reset(args) -> int:
    """重置:只走 admin-key 路径,重置所有配置参数(不重激活、不碰 key)。"""
    sid = args.system_id or ""
    system_home = Path(args.home).expanduser() if args.home else Path()
    if not system_home and sid:
        # 与 install 对齐:--system-id 可反查本地配置的 system_home
        from runtime_core import system_home_from_sid
        sh = system_home_from_sid(sid)
        if not sh:
            _fail(f"--system-id {sid} 无本地配置可反查 --home(系统不在这台机器?)")
        system_home = Path(sh)
        print(f"  --home 由 --system-id 反查: {system_home}")
    if not system_home:
        _fail("reset 需要 --home(系统 home/平台根),或带 --system-id 以便反查")
    if not system_home.exists():
        _fail(f"home 目录不存在: {system_home}")
    platform = resolve_platform(system_home)
    if not platform:
        _fail("无法确定平台")
    sid = sid or _ptr_sid(_platform_ptr(platform))
    if not sid:
        _fail("无法确定 system_id(用 --system-id 指定)")

    # 读 admin-key(.system_raw_key 或已有配置)——只读,不写
    raw_key_path = AIMAIL_HOME / ".system_raw_key" / f"{sid}_admin.key"
    admin_key = ""
    if raw_key_path.is_file():
        try:
            admin_key = raw_key_path.read_text().strip()
        except Exception:
            pass
    if not admin_key:
        cfg_path = _gateway_cfg_path(sid)
        if cfg_path.is_file():
            try:
                admin_key = json.loads(cfg_path.read_text()).get("admin_key", "")
            except Exception:
                pass
    if not admin_key:
        _fail(f"无 admin-key({raw_key_path} 或配置)——reset 只走 admin-key 路径")

    # 从已有配置读默认参数(CLI 显式覆盖)——reset 语义=重置为本机当前实际
    cfg_path = _gateway_cfg_path(sid)
    prev = {}
    if cfg_path.is_file():
        try:
            prev = json.loads(cfg_path.read_text())
        except Exception:
            pass
    gw_url = args.gateway_url or _env_val("AIMAIL_URL") or prev.get("gateway_url", "")
    sys_name = args.system_name or _env_val("AIMAIL_SYSTEM_NAME") or prev.get("system_name", "")
    manager = args.manager or _env_val("AIMAIL_MANAGER_ADDRESS") or prev.get("manager_address", "")

    print(f"  reset platform={platform} system_id={sid}")
    env = dict(os.environ)
    env["INTEGRATE_GATEWAY_URL"] = gw_url
    env["INTEGRATE_SYSTEM_ID"] = sid
    env["INTEGRATE_SYSTEM_NAME"] = sys_name
    env["INTEGRATE_SYSTEM_HOME"] = str(system_home) if system_home else prev.get("system_home", "")
    env["INTEGRATE_MANAGER_ADDRESS"] = manager
    env["INTEGRATE_ADMIN_KEY"] = admin_key
    r = subprocess.call([sys.executable, str(SCRIPTS_DIR / "setup_system.py")], env=env)
    if r != 0:
        _fail("setup_system(reset) 失败")
    _ok("config parameters reset (admin-key path, key untouched)")

    # 平台注册链幂等重跑(配置补全)
    if platform == "hermes":
        env3 = dict(os.environ)
        env3["SYSTEM_ID"] = sid
        r = subprocess.call([sys.executable,
                             str(SCRIPTS_DIR.parent / "pysdk" / "hermes" / "register_profiles.py")],
                            env=env3)
    else:
        env3 = dict(os.environ)
        env3["AIMAIL_SYSTEM_ID"] = sid
        r = subprocess.call([sys.executable, str(SCRIPTS_DIR.parent / "bin" / "register_agent.py"),
                             "--all", "--system-id", sid], env=env3)
    if r != 0:
        _warn(f"registration chain re-run exit {r}(见上方输出)")
    else:
        _ok("registration chain re-run (idempotent)")
    print(f"  建议: aimail check --system-id {sid}")
    return 0


# 平台 agent 标识枚举——各平台集合来源不同(枚举方法平台相关):
#   hermes   : profiles/* 目录名(named profile) + 主会话 "default"(根 .agentmail 存在时)
#   openclaw : agents/* 目录名(agentId)
#   pi       : 固定名 "pi"(单 agent,根 .agentmail 指示注册态)
#   dsh      : 固定名 "agent"(deepseek-harness 无内置默认,主 agent 约定绑 "agent")
#   deerflow : 根 .agentmail 存在时以 "agent" 兜底(agent_id 由宿主 manage.py 提供)
_PLATFORM_DEFAULT_ALIASES = {"hermes": ("default",), "openclaw": ("main",)}


def _platform_agent_names(platform: str, root: Path):
    """平台 agent 标识全集(与平台枚举方法一一对应)。"""
    names = []
    if not root.is_dir():
        return names
    if platform == "hermes":
        pdir = root / "profiles"
        if pdir.is_dir():
            names.extend(p.name for p in sorted(pdir.iterdir()) if p.is_dir())
        if (root / ".agentmail").exists():
            names.append("default")
    elif platform == "openclaw":
        adir = root / "agents"
        if adir.is_dir():
            names.extend(p.name for p in sorted(adir.iterdir()) if p.is_dir())
        elif (root / ".agentmail").exists():
            names.append("main")
    elif platform == "pi":
        names.append("pi")
    elif platform == "dsh":
        names.append("agent")
    elif platform == "deerflow":
        names.append("agent")
    return names


def _list_agents(sid: str, cfg: dict):
    """已注册(地址键目录 agentmail.json)∪ 平台枚举 agent 全集。
    每项含 registered 标记;未注册项的 email 为派生的期望地址。"""
    agents = []
    base = AIMAIL_HOME / "systems" / sid
    domain = cfg.get("domain", "")
    system_name = cfg.get("system_name", "")
    if base.is_dir():
        for d in sorted(base.iterdir()):
            jf = d / "agentmail.json"
            if not jf.is_file():
                continue
            try:
                acfg = json.loads(jf.read_text())
            except Exception:
                continue
            email = acfg.get("email", "")
            if not email:
                continue
            # agent 名 = platform pointer 所在目录名(profile/agent id),反查
            agent_name = None
            sys_home = acfg.get("system_home", "") or acfg.get("home", "")
            if sys_home and Path(sys_home).is_dir():
                for ptr in _scan_pointers(Path(sys_home)):
                    if ptr.get("email") == email and ptr.get("system_id") == sid:
                        agent_name = ptr.get("agent_name")
                        break
            if not agent_name:
                local = email.split("@")[0]
                agent_name = local.split(".")[0] if "." in local else local
            agents.append({
                "agent": agent_name,
                "email": email,
                "manager": acfg.get("manager_address", ""),
                "webhook_url": acfg.get("webhook_url", ""),
                "dir": str(d),
                "cfg": acfg,
                "registered": True,
            })
    # 平台枚举:未注册的 agent(新增场景检测)
    platform = ""
    sh = cfg.get("system_home", "")
    if sh:
        platform = detect_platform_from_home(Path(sh))
    known = {a["agent"] for a in agents}
    if platform and sh:
        aliases = _PLATFORM_DEFAULT_ALIASES.get(platform, ())
        for name in _platform_agent_names(platform, Path(sh)):
            if name in known:
                continue
            base_name = "agent" if name in aliases else name
            import re as _re
            cleaned = _re.sub(r"[^A-Za-z0-9!#$%&'*+\-/=?^_`{|}~]", "_", base_name) or "agent"
            want = f"{cleaned}.{system_name}@{domain}" if system_name else f"{cleaned}@{domain}"
            if not any(a["email"] == want for a in agents):
                agents.append({
                    "agent": name,
                    "email": want,
                    "manager": "",
                    "webhook_url": "",
                    "dir": "",
                    "cfg": {},
                    "registered": False,
                    "platform": platform,
                })
    agents.sort(key=lambda a: (not a["registered"], a["agent"]))
    return agents


def _scan_pointers(platform_root: Path):
    """扫描平台根下的注册指针(.aimail/.agentmail 文件,内容含 system_id+email)。
    agent 名 = 指针文件所在目录名(hermes profile / openclaw agent id)。"""
    found = []
    if not platform_root.is_dir():
        return found
    for dirpath, dirnames, filenames in os.walk(platform_root):
        dirnames[:] = [d for d in dirnames if d not in (".git", "node_modules", ".venv")]
        for fn in filenames:
            if fn in (".aimail", ".agentmail", "agentmail.json"):
                fp = os.path.join(dirpath, fn)
                try:
                    data = json.loads(open(fp).read())
                except Exception:
                    continue
                email = data.get("email", "")
                sid = data.get("system_id", "")
                if email and sid:
                    # Root-level pointer (platform home itself, e.g.
                    # ~/.hermes/.agentmail) binds the platform's main
                    # session — conventionally "default"/"main"; named
                    # profile/agent dirs use their own directory name.
                    if Path(dirpath) == platform_root:
                        agent_name = "default"
                    else:
                        agent_name = os.path.basename(dirpath)
                    found.append({
                        "agent_name": agent_name,
                        "email": email,
                        "system_id": sid,
                    })
                continue
    return found


def cmd_address(args) -> int:
    """address:查看/维护系统 agent 地址(default 默认主 agent 名、set-name 地址名、
    set-manager 管理员地址)。"""
    sid = args.system_id or ""
    if not sid:
        _fail("address 需要 --system-id")
    cfg_path = _gateway_cfg_path(sid)
    if not cfg_path.is_file():
        _fail(f"无系统配置: {cfg_path}")
    cfg = json.loads(cfg_path.read_text())

    op = args.op.lower() if getattr(args, "op", None) else (
        "default" if args.default
        else "set-manager" if args.manager
        else "set-name" if args.name
        else "list"
    )

    # ── 查看 ──────────────────────────────────────────────
    if op in ("list", "show"):
        agents = _list_agents(sid, cfg)
        current = cfg.get("default_agent_name", "agent")
        platform = ""
        sh = cfg.get("system_home", "")
        if sh:
            platform = detect_platform_from_home(Path(sh))
        print(f"  system: {sid} ({platform or '?'})")
        print(f"  默认主 agent 名: {current}")
        print(f"  (默认映射: hermes default→{current}, openclaw main→{current})")
        print()
        if not agents:
            print("  无本地注册 agent(地址键目录为空)。")
            return 0
        print(f"  {'agent':<18} {'email':<46} {'manager':<30} webhook   状态")
        for a in agents:
            wh = (a["webhook_url"] or "")[:28]
            if a.get("registered"):
                print(f"  {a['agent']:<18} {a['email']:<46} {a['manager']:<30} {wh}  已注册")
            else:
                print(f"  {a['agent']:<18} {(a['email'] or ''):<46} {'':<30} {'':<28}  未注册(平台 {a.get('platform','?')} 有该 agent,先 install/bind 注册)")
        return 0

    # ── 目标解析: -a agent 名 / -e email ───────────────────
    agents = _list_agents(sid, cfg)
    target = None
    if args.email:
        target = next((a for a in agents if a["email"] == args.email.lower()), None)
        if not target:
            _fail(f"本机未找到地址 {args.email} 的 agentmail.json(先在该 agent 上跑 install 注册)")
    elif args.agent:
        target = next((a for a in agents if a["agent"] == args.agent
                        or (a["email"] and a["email"].split("@")[0].startswith(args.agent))), None)
        if not target:
            _fail(f"本机未找到 agent '{args.agent}' 的注册地址(agentmail.json)。"
                  f" 平台 agent: {[a['agent'] for a in agents] or '无'}")
        if not target.get("registered"):
            _fail(f"agent '{args.agent}' 尚未注册(平台 {target.get('platform','?')} 存在但无地址)。"
                  f" 先在平台侧注册该 agent(install/对应平台绑定),注册后再用 address 改名或设 manager。"
                  f" 若其期望地址 {target.get('email')} 已被占用,注册时会冲突。")

    # ── default:默认主 agent 名(原 mailname)──────────────
    if op == "default":
        new_name = args.default or args.name or ""
        if not new_name:
            _fail("address default 需要 -n <名字>")
        _set_default_agent_name(cfg, cfg_path, sid, new_name)
        return 0

    if target is None:
        _fail("该操作需要 -a <agent> 或 -e <email> 定位目标地址")

    # ── set-manager ───────────────────────────────────────
    if op == "set-manager":
        mgr = args.manager or ""
        if not mgr or "@" not in mgr:
            _fail("address set-manager 需要 -m <manager 邮箱>")
        load_core()
        from aimail_tools import _GatewayClient
        gw = cfg.get("gateway_url", "").rstrip("/")
        ak = cfg.get("admin_key", "")
        if not gw or not ak:
            _fail("系统配置缺 gateway_url/admin_key(本地只改配置,云端未同步)")
        client = _GatewayClient(gw, ak)
        email = target["email"]
        try:
            client._request("PUT", f"/api/v1/admin/agent-meta/{email}",
                            body={"manager_address": mgr})
        except Exception as e:
            _fail(f"更新 manager 失败: {e}")
        tgt_cfg = dict(target["cfg"])
        tgt_cfg["manager_address"] = mgr
        jf = Path(target["dir"]) / "agentmail.json"
        _atomic_json_write(jf, tgt_cfg)
        _ok(f"manager: {email} → {mgr}(云端+本地已同步)")
        return 0

    # ── set-name:地址名切换(服务端 rename + 本地迁移)──────
    if op == "set-name":
        new_name = args.name or ""
        if not new_name:
            _fail("address set-name 需要 -n <新地址名>")
        import re as _re
        if not _re.fullmatch(r"[A-Za-z0-9!#$%&'*+\-/=?^_`{|}~]+", new_name):
            _fail(f"非法名字 '{new_name}':须为 atext-no-dot 字符(不能含点/空格/@)")
        email = target["email"]
        domain = cfg.get("domain", "") or email.split("@", 1)[1]
        shared = str(sid).startswith("shared-")
        new_email = f"{new_name}.{email.split('@')[0].split('.',1)[1]}@{domain}" if shared and "." in email.split("@")[0] else f"{new_name}@{domain}"
        # 冲突预检:与同系统其它已注册地址的 base 冲突
        for a in agents:
            if a["email"] != email and a["email"].split("@")[0] == new_email.split("@")[0]:
                _fail(f"新地址名 '{new_name}' 与已注册地址 {a['email']} 冲突")
        if new_email == email:
            print(f"  已是该地址: {email}")
            return 0
        load_core()
        from aimail_tools import _GatewayClient
        gw = cfg.get("gateway_url", "").rstrip("/")
        ak = cfg.get("admin_key", "")
        if not gw or not ak:
            _fail("系统配置缺 gateway_url/admin_key")
        client = _GatewayClient(gw, ak)
        try:
            client._request("POST", f"/api/v1/admin/systems/{sid}/addresses/rename",
                            body={"old_email": email, "new_email": new_email})
        except Exception as e:
            _fail(f"服务端改名失败(未改动本地): {e}")
        # 本地迁移:目录改名 + email 字段更新(webhook/api_key/secret 全继承)
        old_dir = Path(target["dir"])
        new_dir = old_dir.parent / new_email.replace("/", "_")
        tgt_cfg = dict(target["cfg"])
        tgt_cfg["email"] = new_email
        try:
            if new_dir.exists():
                _warn(f"本地目录 {new_dir} 已存在,合并内容字段(保留两个目录)")
            else:
                old_dir.rename(new_dir)
            _atomic_json_write(new_dir / "agentmail.json", tgt_cfg)
        except Exception as e:
            _warn(f"本地迁移失败(云端已改名,重跑 install 可重建本地): {e}")
            return 0
        _ok(f"地址改名: {email} → {new_email}")
        print(f"  服务端资源(白名单/联系人/看板/密钥)与本地 agentmail.json 全部继承")
        print(f"  生效:同 key 继续使用,新地址即日起收发")
        return 0

    _fail(f"未知操作: {op}(支持 list/default/set-name/set-manager)")


def _atomic_json_write(path: Path, data: dict) -> None:
    tmp = path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False))
    tmp.replace(path)


def _set_default_agent_name(cfg: dict, cfg_path: Path, sid: str, new_name: str) -> None:
    """写 default_agent_name(冲突检测)。原 mailname 逻辑。"""
    import re
    if not re.fullmatch(r"[A-Za-z0-9!#$%&'*+\-/=?^_`{|}~]+", new_name):
        _fail(f"非法名字 '{new_name}':须为 atext-no-dot 字符(不能含点/空格/@)")
    current = cfg.get("default_agent_name", "agent")
    if new_name == current:
        print(f"  已是当前默认名: {current}")
        return
    # 冲突检测:已注册地址中 base 段占用
    load_core()
    from aimail_tools import _GatewayClient
    gw = cfg.get("gateway_url", "").rstrip("/")
    ak = cfg.get("admin_key", "")
    if gw and ak:
        try:
            client = _GatewayClient(gw, ak)
            domains = client.list_system_domains(sid)
            occupied = []
            for d in domains if isinstance(domains, list) else []:
                addr = d.get("domain") or ""
                base = addr.split("@")[0] if "@" in addr else ""
                if base == new_name:
                    occupied.append(addr)
            if occupied:
                _fail(f"名字 '{new_name}' 已占用: {occupied}")
        except Exception as e:
            _warn(f"冲突检测失败(仅本地校验): {e}")
    cfg["default_agent_name"] = new_name
    _atomic_json_write(cfg_path, cfg)
    _ok(f"默认主 agent 名: {current} → {new_name}")
    print(f"  生效方式:agent 地址将变为 {new_name}@{cfg.get('domain','')}(共享域加 .{cfg.get('system_name','')} 后缀)")
    print(f"  需重注册:aimail reset --system-id {sid} 或 aimail install")


