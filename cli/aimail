def main():
    _load_env()
    ap = argparse.ArgumentParser(
        prog="aimail",
        description="aimail CLI - set up, operate and maintain the AIMail link "
                    "between your agent platform and the aimail-gateway.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
scenario groups:
  setup      machine prep and platform integration: init / install / uninstall / reset
  operate    daily status and lifecycle: stats / renew / version
  diagnose   exams and fixes when something is wrong: check / repair / ping / welcome / persona
  resources  system-scoped resources: domain / address / bridge
""")
    sub = ap.add_subparsers(dest="command", required=True, metavar="<command>")

    common_sid = {"help": "target system id (default: the only installed system)"}
    common_home = {"help": "platform root dir (hermes=~/.hermes, openclaw=~/.openclaw, ...)"}
    common_gw = {"help": "gateway URL (default: AIMAIL_URL env or aimail_gateway.json)"}
    common_mgr = {"help": "manager address (approvals contact); default: config/env"}

    # ── setup ──────────────────────────────────────────────────────
    p_init = sub.add_parser("init", help="one-time machine setup: lock gateway URL, direct or bridge mode")
    p_init.add_argument("-g", "--gateway-url", default=None, **common_gw)
    p_init.set_defaults(func=cmd_init)

    p_install = sub.add_parser("install", help="integrate an agent platform with an AIMail system (activate or reuse)")
    p_install.add_argument("-H", "--home", **common_home)
    p_install.add_argument("-s", "--system-id", **common_sid)
    p_install.add_argument("-c", "--product-code", help="product activation code (new system path)")
    p_install.add_argument("-k", "--admin-key", help="admin key of an already-activated system (reuse path)")
    p_install.add_argument("-g", "--gateway-url", default=None, **common_gw)
    p_install.add_argument("-n", "--system-name", help="system name (shared-domain identifier)")
    p_install.add_argument("-m", "--manager", **common_mgr)
    p_install.add_argument("-d", "--domain", help="domain to pre-create (default: AIMAIL_DOMAIN env)")
    p_install.set_defaults(func=cmd_install)

    p_uni = sub.add_parser("uninstall", help="remove aimail integration from the agent platform")
    p_uni.add_argument("-s", "--system-id", **common_sid)
    p_uni.add_argument("-H", "--home", **common_home)
    p_uni.add_argument("-y", "--yes", action="store_true", help="skip confirmation prompt")
    p_uni.set_defaults(func=cmd_uninstall)

    p_reset = sub.add_parser("reset", help="re-reset connection config for an activated system (no re-activation)")
    p_reset.add_argument("-H", "--home", **common_home)
    p_reset.add_argument("-s", "--system-id", **common_sid)
    p_reset.add_argument("-g", "--gateway-url", default="", **common_gw)
    p_reset.add_argument("-n", "--system-name")
    p_reset.add_argument("-m", "--manager", **common_mgr)
    p_reset.set_defaults(func=cmd_reset)

    # ── operate ────────────────────────────────────────────────────
    p_stats = sub.add_parser("stats", help="local integration status: systems, agents, mail stats")
    p_stats.add_argument("-a", "--all", action="store_true",
                         help="full view: per-system health tags + broken systems + local platforms")
    p_stats.set_defaults(func=cmd_stats)

    p_renew = sub.add_parser("renew", help="renew a system with a product code, or show expiry read-only")
    p_renew.add_argument("-s", "--system-id", **common_sid)
    p_renew.add_argument("-c", "--code", help="product activation code (omit for read-only expiry view)")
    p_renew.add_argument("-t", "--status", action="store_true", help="read-only expiry & quota view (no code consumed)")
    p_renew.add_argument("-g", "--gateway-url", default=None, **common_gw)
    p_renew.set_defaults(func=cmd_renew)

    p_version = sub.add_parser("version", help="show CLI/bootstrap version (upgrade detection)")
    p_version.set_defaults(func=cmd_version)

    # ── diagnose ───────────────────────────────────────────────────
    p_check = sub.add_parser("check", help="full health exam: config files, runtime resources, delivery links")
    p_check.add_argument("-s", "--system-id", **common_sid)
    p_check.add_argument("-H", "--home", **common_home)
    p_check.set_defaults(func=cmd_check)

    p_repair = sub.add_parser("repair", help="auto-fix per check findings, then re-check (idempotent)")
    p_repair.add_argument("-s", "--system-id", **common_sid)
    p_repair.add_argument("-H", "--home", help="platform root (auto-resolved on single-platform machines)")
    p_repair.add_argument("-D", "--deep", action="store_true",
                          help="deep: rewrite webhook pairing from agentmail.json + drain stuck pending")
    p_repair.add_argument("-n", "--dry-run", dest="dry_run", action="store_true",
                          help="print the fix plan without executing")
    p_repair.set_defaults(func=cmd_repair)

    p_ping = sub.add_parser("ping", help="end-to-end ping-pong delivery test (manager <-> agent)")
    p_ping.add_argument("-s", "--system-id", **common_sid)
    p_ping.add_argument("-m", "--manager", **common_mgr)
    p_ping.add_argument("-t", "--timeout", type=int, default=120, help="wait timeout seconds (default 120)")
    p_ping.set_defaults(func=cmd_ping)

    p_welcome = sub.add_parser("welcome", help="welcome-email end-to-end test (API mode by default)")
    p_welcome.add_argument("-s", "--system-id", **common_sid)
    p_welcome.add_argument("-m", "--manager", **common_mgr)
    p_welcome.add_argument("-w", "--no-wait", action="store_true", help="do not wait for the draft reply")
    p_welcome.add_argument("--smtp", action="store_true",
                           help="legacy SMTP mode (default: API mode via the gateway system sender)")
    p_welcome.set_defaults(func=cmd_welcome)

    p_persona = sub.add_parser("persona", help="persona flow: manager sends 'update persona', agent replies with draft")
    p_persona.add_argument("-s", "--system-id", **common_sid)
    p_persona.add_argument("-m", "--manager", **common_mgr)
    p_persona.add_argument("-w", "--no-wait", action="store_true", help="do not wait for the draft reply")
    p_persona.set_defaults(func=cmd_persona)

    # ── resources ──────────────────────────────────────────────────
    p_dom = sub.add_parser("domain", help="list or create domains owned by a system")
    p_dom.add_argument("-s", "--system-id", **common_sid)
    p_dom.add_argument("-a", "--add", metavar="DOMAIN", help="create a domain (bare domain, lowercase; default: list only)")
    p_dom.add_argument("--id", help="domain record id (default: auto-generated)")
    p_dom.add_argument("-w", "--webhook-url", help="webhook receiver URL for the new domain")
    p_dom.set_defaults(func=cmd_domain)

    p_ad = sub.add_parser("address", help="view/maintain system agent addresses (default name / set-name / set-manager)")
    p_ad.add_argument("-s", "--system-id", **common_sid)
    p_ad.add_argument("-d", "--default", metavar="NAME", help="set the default main-agent name (was: mailname)")
    p_ad.add_argument("-a", "--agent", help="target agent (platform session/profile id) for set-name/set-manager")
    p_ad.add_argument("-e", "--email", help="target by exact registered email instead of -a")
    p_ad.add_argument("-n", "--name", metavar="NAME", help="new address name (set-name) or with -d the default name")
    p_ad.add_argument("-m", "--manager", metavar="EMAIL", help="new manager address for the target agent (set-manager)")
    p_ad.set_defaults(func=cmd_address)

    p_br = sub.add_parser("bridge", help="local bridge: status / refresh routes / restart")
    p_br.add_argument("-s", "--system-id", help="refresh forwarding routes for this system")
    p_br.add_argument("-H", "--home", **common_home)
    p_br.add_argument("-r", "--restart", action="store_true", help="restart the bridge (single instance)")
    p_br.set_defaults(func=cmd_bridge)

    args = ap.parse_args()
    sys.exit(args.func(args) or 0)


if __name__ == "__main__":
    main()
