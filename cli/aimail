    p_br.add_argument("--home", help="系统 home(平台根),配合重刷")
    p_br.add_argument("--restart", action="store_true", help="重启 bridge(单实例)")
    p_br.set_defaults(func=cmd_bridge)

    p_check = sub.add_parser("check", help="状态检查")
    p_check.add_argument("--system-id")
    p_check.add_argument("--home", help="系统 home(平台根)")
    p_check.set_defaults(func=cmd_check)

    p_dom = sub.add_parser("domain", help="查看/创建指定系统的域名")
