def cmd_mailname(args) -> int:
    """查看/修改默认主 agent 名字映射(冲突检测)。"""
    sid = args.system_id or ""
    if not sid:
        _fail("mailname 需要 --system-id")
    cfg_path = SYSTEMS_DIR / sid / "agentmail_gateway.json"
    if not cfg_path.is_file():
        _fail(f"无系统配置: {cfg_path}")
    cfg = json.loads(cfg_path.read_text())
    current = cfg.get("default_agent_name", "agent")

    if not args.default:
        # 查看
        platform = ""
        sh = cfg.get("system_home", "")
        if sh:
            platform = detect_platform_from_home(Path(sh))
        if platform in ("", "unknown"):
            for p in ("openclaw", "hermes"):
                if _ptr_sid(_platform_ptr(p)) == sid:
                    platform = p
                    break
        if not platform:
            platform = "?"
        print(f"  system: {sid} ({platform})")
        print(f"  默认主 agent 名: {current}")
        print(f"  (默认映射: hermes default→{current}, openclaw main→{current})")
        return 0

    new_name = args.default
    # 合法性:atext-no-dot(与 email_for_agent 清洗一致)
    import re
    if not re.fullmatch(r"[A-Za-z0-9!#$%&'*+\-/=?^_`{|}~]+", new_name):
        _fail(f"非法名字 '{new_name}':须为 atext-no-dot 字符(不能含点/空格/@)")
    if new_name == current:
        print(f"  已是当前默认名: {current}")
        return 0

    # 冲突检测:domain_addr_meta 已有同名非默认 agent 地址
    # 通过网关 API 查询该系统的已注册地址(_GatewayClient 带完整方法集)
    load_core()
    from aimail_tools import _GatewayClient
    gw = cfg.get("gateway_url", "").rstrip("/")
    ak = cfg.get("admin_key", "")
    if gw and ak:
        try:
            client = _GatewayClient(gw, ak)
            domains = client.list_system_domains(sid)
            occupied = []
            # domain 字段可能是注册地址(如 agent.xianlin@amail.token.tm)
            # 或 anchor(xianlin@amail.token.tm)——检查新默认名是否与已有
            # 地址的 base 段冲突(用户定调:改前检测与其他 agent 名字冲突)
            for d in domains if isinstance(domains, list) else []:
                addr = d.get("domain") or ""
                base = addr.split("@")[0] if "@" in addr else ""
                if base == new_name:
                    occupied.append(addr)
            if occupied:
                _fail(f"名字 '{new_name}' 已占用: {occupied}")
        except Exception as e:
            _warn(f"冲突检测失败(仅本地校验): {e}")

    # 写入配置
    cfg["default_agent_name"] = new_name
    tmp = cfg_path.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(cfg, indent=2, ensure_ascii=False))
    tmp.replace(cfg_path)
    _ok(f"默认主 agent 名: {current} → {new_name}")
    print(f"  生效方式:agent 地址将变为 {new_name}@{cfg.get('domain','')}(共享域加 .{cfg.get('system_name','')} 后缀)")
    print(f"  需重注册:aimail reset --system-id {sid} 或 aimail install")
    return 0


