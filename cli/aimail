def cmd_init(args) -> int:
    """机器级基础环境(一次):主目录构建 → 磁盘研判 → 网络结构(网关/直连
    or bridge)。零系统可跑;激活(install)在其后进行。"""
    # 1) 主目录构建(幂等;0700 仅本用户可读——含 admin key/secret)
    try:
        for sub in ("", "systems", "logs", "bridge"):
            d = AIMAIL_HOME if not sub else AIMAIL_HOME / sub
            d.mkdir(parents=True, exist_ok=True)
            os.chmod(d, 0o700)
    except OSError as e:
        _warn(f"主目录构建失败: {e}")
    print(f"  init: 主目录 = {AIMAIL_HOME}")

    # 2) 磁盘研判(评估:邮件快照/桥日志/系统配置,量级小;阈值防御性)
    try:
        st = os.statvfs(AIMAIL_HOME)
        free_mib = (st.f_bavail * st.f_frsize) // (1024 * 1024)
        if free_mib < 100:
            _warn(f"磁盘可用空间不足: {free_mib} MiB(<100 MiB)——aimail 建议留足日志/快照空间")
        elif free_mib < 1024:
            _warn(f"磁盘可用空间偏低: {free_mib} MiB(<1 GiB)——留意日志/邮件快照增长")
        else:
            print(f"  init: 磁盘可用 = {free_mib} MiB(充足)")
    except OSError as e:
        _warn(f"磁盘研判失败: {e}")

    # 3) 网络结构:网关在哪、直连 or bridge
    gw = args.gateway_url or _env_val("AIMAIL_URL") or _probe_local_gateway()
    if not gw:
        gw = "https://aimail.token.tm"  # 默认远程网关
    print(f"  init: 网关 = {gw}")

    if _is_local_gateway(gw):
        # 本地自建网关 → 直连 push,无需 bridge(注册三态第 3 支)
        print("  ✓ 本地网关(直连 push)——无需 bridge,系统注册时直连本地端点")
        print("  init done. 接下来: aimail install(激活系统并绑定平台)")
        return 0

    # 远程网关 → bridge push:二进制 + 骨架配置(首次 install 补 key 并启动)
    env = dict(os.environ)
    env["GATEWAY_URL"] = gw
    env.setdefault("WEBHOOK_MODE", "bridge")
    r = subprocess.call([sys.executable, str(SCRIPTS_DIR / "deploy_bridge.py"),
                         "--init"], env=env)
    if r != 0:
        _warn(f"bridge init exit {r}")
        return r
    print("  init done. 接下来: aimail install(激活系统,首次将补齐 bridge key 并启动)")
    return 0


def _write_pi_pointer(sid: str) -> None:
    """写 ~/.pi/.agentmail {system_id, email}(与 openclaw pointer 同构)。"""
    try:
        load_core()
        from aimail_base import email_for_agent  # noqa: E402
    except Exception:
        return
    cfg_path = _gateway_cfg_path(sid)
    if not cfg_path.is_file():
        return
    try:
        cfg = json.loads(cfg_path.read_text())
    except Exception:
        return
    email = email_for_agent("pi", cfg.get("domain", ""), cfg.get("system_name", ""))
    if not email:
        return
    ptr = Path.home() / ".pi" / ".agentmail"
    try:
        ptr.parent.mkdir(parents=True, exist_ok=True)
        ptr.write_text(json.dumps({"system_id": sid, "email": email}))
        _ok(f"pi pointer written {ptr}")
    except Exception as e:
        _warn(f"pi pointer write failed: {e}")


def cmd_install(args) -> int:
    """安装:集成脚本到 check 前的全部步骤(非交互化)。"""
    load_core()
    from gateway_api import load_gateway_config
    env = dict(os.environ)
    gw_url = args.gateway_url or _env_val("AIMAIL_URL", "https://aimail.token.tm")
    sys_name = args.system_name or _env_val("AIMAIL_SYSTEM_NAME")
    manager = args.manager or _env_val("AIMAIL_MANAGER_ADDRESS")
    prod_code = args.product_code or _env_val("AIMAIL_PRODUCT_CODE")
    adm_key = args.admin_key or _env_val("AIMAIL_ADMIN_KEY")
    want_domain = args.domain or _env_val("AIMAIL_DOMAIN")
    sid = args.system_id or ""

    # 目标双向反查:--home 与 --system-id 任给其一,另一个可从本地配置
    # (systems/{sid}/aimail_gateway.json 的 system_home)反查;都缺 → 报错。
    system_home = Path(args.home).expanduser() if args.home else Path()
    if not system_home and sid:
        from runtime_core import system_home_from_sid
        sh = system_home_from_sid(sid)
        if not sh:
            _fail(f"--system-id {sid} 无本地配置可反查 --home(系统不在这台机器?)")
        system_home = Path(sh)
        print(f"  --home 由 --system-id 反查: {system_home}")
    if not sid and system_home and not prod_code and not adm_key:
        # 重复安装:home 归属唯一系统 → 自动复用;多个归属不猜,提示显式
        from runtime_core import sid_from_system_home
        sid2 = sid_from_system_home(str(system_home))
        if sid2:
            sid = sid2
            print(f"  复用归属系统: {sid}(由 --home 反查)")
    if not system_home:
        _fail("install 需要 --home,或带 --system-id 以便从本地配置反查")
    if not system_home.exists():
        _fail(f"home 目录不存在: {system_home}")
    platform = resolve_platform(system_home)
    if not platform:
        _fail(f"无法确定平台:{system_home} 目录无特征且无 aimail 指针")
    print(f"  install platform={platform} system_home={system_home} system_id={sid or '(新建)'}")

    # 激活/复用凭据装配(env 契约给 setup_system.py)
    env["INTEGRATE_GATEWAY_URL"] = gw_url
    env["INTEGRATE_SYSTEM_ID"] = sid
    env["INTEGRATE_SYSTEM_NAME"] = sys_name
    env["INTEGRATE_SYSTEM_HOME"] = str(system_home)
    env["INTEGRATE_MANAGER_ADDRESS"] = manager
    env["INTEGRATE_AIMAIL_DOMAIN"] = want_domain
    env["INTEGRATE_SAVE_SNAPSHOTS"] = (
        "true" if _env_val("AIMAIL_SAVE_SNAPSHOTS", "no").lower() in ("yes", "true", "1") else "false")
    env["INTEGRATE_WEBHOOK_HOST"] = _env_val("AIMAIL_WEBHOOK_HOST")
    if prod_code:
        env["INTEGRATE_USE_PRODUCT_CODE"] = "true"
        env["INTEGRATE_PRODUCT_CODE"] = prod_code
    elif adm_key:
        env["INTEGRATE_ADMIN_KEY"] = adm_key
    # 无显式凭据 → 从已有配置复用(显式 --system-id 或 home 反查出的系统)
    elif sid:
        cfg = load_gateway_config(sid)
        if cfg and cfg.get("admin_key"):
            env["INTEGRATE_ADMIN_KEY"] = cfg["admin_key"]
            env["INTEGRATE_SYSTEM_ID"] = sid

    try:
        out = subprocess.check_output(
            [sys.executable, str(SCRIPTS_DIR / "setup_system.py")],
            env=env, text=True, stderr=subprocess.STDOUT)
    except subprocess.CalledProcessError as e:
        _fail(f"setup_system 失败: {(e.output or '').strip()[-400:]}")
    _ok("system configured")
    # 解析激活生成的 system_id(新系统路径 id 由服务器分配)
    sid2 = sid or ""
    for line in out.splitlines():
        if line.startswith("__ERROR__"):
            _fail(line[len("__ERROR__"):].strip())
    try:
        data = json.loads(out)
        sid2 = data.get("system_id") or sid2
    except Exception:
        pass
    if sid2 and sid2 != (args.system_id or ""):
        env["INTEGRATE_SYSTEM_ID"] = sid2
        _ok(f"system_id: {sid2}")

    # 1b) domain 预置/创建:AIMAIL_DOMAIN 指定且系统缺失时主动创建
    if want_domain and sid2:
        load_core()
        try:
            from aimail_tools import _GatewayClient
            client = _GatewayClient(gw_url, env.get("INTEGRATE_ADMIN_KEY") or "")
            existing = client.list_system_domains(sid2)
            if isinstance(existing, list):
                if any((d.get("domain") or "").lower() == want_domain.lower() for d in existing):
                    _ok(f"domain present: {want_domain}")
                else:
                    body = {"id": f"d{int(time.time())}", "domain": want_domain.strip().lower()}
                    res = client._request("POST", f"/api/v1/admin/systems/{sid2}/domains", body=body)
                    if isinstance(res, dict) and res.get("error"):
                        _warn(f"domain create failed: {res.get('error')} {res.get('detail') or ''}".strip())
                    else:
                        _ok(f"domain created: {want_domain}")
            else:
                _warn(f"domain check failed: {existing}")
        except Exception as e:
            _warn(f"domain ensure skipped: {e}")

    # 2) 部署 bridge(单实例多系统合并;本地直连网关无需桥)
    if _is_local_gateway(gw_url):
        _ok("bridge: 本地网关直连模式,无需 bridge")
    else:
        env2 = dict(os.environ)
        env2["GATEWAY_URL"] = env["INTEGRATE_GATEWAY_URL"]
        env2["ADMIN_KEY"] = env.get("INTEGRATE_ADMIN_KEY", "")
