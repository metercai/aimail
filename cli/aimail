def _resolve_renew_target(args) -> tuple[str, str, str]:
    """解析 renew 目标系统 → (system_id, gateway_url, admin_key)。

    --system-id 显式指定;省略时:唯一系统自动选定,多系统报错列出。
    """
    load_core()
    from gateway_api import load_gateway_config
    candidates: list[str] = []
    if SYSTEMS_DIR.is_dir():
        for d in sorted(SYSTEMS_DIR.iterdir()):
            if d.is_dir() and _gateway_cfg_path(d.name).is_file():
                candidates.append(d.name)
    sid = args.system_id
    if not sid:
        if not candidates:
            _fail("no aimail systems configured; use --system-id")
        if len(candidates) == 1:
            sid = candidates[0]
        else:
            _fail(f"multiple systems installed: {', '.join(candidates)}; use --system-id")
    elif sid not in candidates:
        _fail(f"system not found locally: {sid} (installed: {', '.join(candidates) or 'none'})")
    cfg = load_gateway_config(sid) or {}
    gw_url = args.gateway_url or cfg.get("gateway_url") or _env_val("AIMAIL_URL", "https://aimail.token.tm")
    admin_key = cfg.get("admin_key") or ""
    if not admin_key:
        _fail(f"no admin_key in aimail_gateway.json for {sid}")
    return sid, gw_url, admin_key


def cmd_renew(args) -> int:
    """续期系统(消耗产品激活码)或只读到期状态。

    --code 给出 → POST /api/v1/admin/renew-system(叠加式: max(now,到期)+新码 validity)。
    --code 省略 → GET /api/v1/quotas 只读展示 expires_at/配额。
    """
    sid, gw_url, admin_key = _resolve_renew_target(args)
    from aimail_tools import _GatewayClient
    client = _GatewayClient(gw_url, admin_key)

    if getattr(args, "status", False) or not getattr(args, "code", None):
        r = client._request("GET", "/api/v1/quotas")
        if not isinstance(r, dict) or r.get("status") != 200:
            _fail(f"quotas query failed: {r}")
        exp = r.get("expires_at") or "unlimited"
        print(f"  system {sid}")
        print(f"    product: {r.get('product_id')} · validity: {r.get('validity_days')} days")
        print(f"    expires_at: {exp}")
        # ≤3 天预警(与 stats 同规则)
        if r.get("expires_at"):
            try:
                from datetime import datetime, timezone
                dt = datetime.fromisoformat(str(r["expires_at"]).replace("Z", "+00:00"))
                days = (dt - datetime.now(timezone.utc)).days
                if days <= 3:
                    _warn(f"expires in {days} day(s) — renew with: aimail renew --system-id {sid} --code <activation-code>")
                else:
                    print(f"    {days} day(s) remaining")
            except Exception:
                pass
        print(f"    quotas: domains {r.get('max_domains')} · addresses {r.get('max_addresses')} · "
              f"daily {r.get('max_daily_emails')} · attachments {r.get('max_attachments')}")
        return 0

    code = str(args.code).strip()
    print(f"  renewing system {sid} with activation code {code[:12]}...")
    r = client._request("POST", "/api/v1/admin/renew-system", body={"code": code})
    if not isinstance(r, dict) or r.get("status") not in (200, "renewed", "200"):
        _fail(f"renew failed: {r}")
    _ok(f"renewed: expires_at {r.get('expires_at')}")
    q = r.get("quota") or {}
    if q:
        print(f"    merged quotas: domains {q.get('max_domains')} · addresses {q.get('max_addresses')} · "
              f"daily {q.get('max_daily_emails')} · attachments {q.get('max_attachments')}")
    print(f"    product: {r.get('product_id')} ({r.get('product_name')})")
    return 0



