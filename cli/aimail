def _sdk_install(kind: str, system_home: Path, sid: str) -> int:
    """调 pysdk 自足安装入口(A 过渡:仓库同仓 import;Rust CLI 终态
    走 spawn `python -m aimail.install`——同一进程命令契约)。"""
    sys.path.insert(0, str(SCRIPTS_DIR.parent / "pysdk"))
    try:
        import install as _sdk
    except Exception as e:  # noqa: BLE001
        _warn(f"pysdk import failed: {e}(SDK 缺失?)")
        return 1
    if kind == "hermes":
        return _sdk.install_hermes(str(system_home), sid)
    # deerflow:backend 目录归一
    backend = system_home if (system_home / "app").is_dir() else system_home / "backend"
    return _sdk.install_deerflow(str(backend), sid)


def _sdk_uninstall(kind: str, system_home: Path, sid: str) -> int:
    """调 pysdk 自足卸载入口(撤销 SDK 自己打的 patch/装的文件)。"""
    sys.path.insert(0, str(SCRIPTS_DIR.parent / "pysdk"))
    try:
        import install as _sdk
    except Exception as e:  # noqa: BLE001
        _warn(f"pysdk import failed: {e}")
        return 1
    if kind == "hermes":
        return _sdk.uninstall_hermes(str(system_home), sid)
    backend = system_home if (system_home / "app").is_dir() else system_home / "backend"
    return _sdk.uninstall_deerflow(str(backend))


def _is_local_gateway(url: str) -> bool:
    """网关是否本机/本地网络(直连 push,无需 bridge)。"""
    try:
        from urllib.parse import urlparse
        host = urlparse(url).netloc.rsplit("@", 1)[-1]
        if ":" in host and not host.startswith("["):
            host = host.rsplit(":", 1)[0]
        host = host.strip("[]")
        if host in ("127.0.0.1", "localhost", "::1"):
            return True
        # 本机所有 IP 也算本地
        import socket
        for info in socket.getaddrinfo(socket.gethostname(), None):
            if info[4][0] == host:
                return True
    except Exception:
        pass
    return False


def _probe_local_gateway() -> str:
    """探测本机网关(默认 127.0.0.1:38080),通则返回其 URL。"""
    import socket
    for port in (38080,):
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=1):
                return f"http://127.0.0.1:{port}"
        except OSError:
            pass
    return ""


def cmd_init(args) -> int:
    """机器级基础环境(一次):锁定网络结构——网关在哪、直连还是 bridge。
    零系统可跑;激活(install)在其后进行。"""
    gw = args.gateway_url or _env_val("AIMAIL_URL") or _probe_local_gateway()
    if not gw:
        gw = "https://amail.token.tm"  # 默认远程网关
    print(f"  init: 网关 = {gw}")

    if _is_local_gateway(gw):
        # 本地自建网关 → 直连 push,无需 bridge(注册三态第 3 支)
        print("  ✓ 本地网关(直连 push)——无需 bridge,系统注册时直连本地端点")
        print("  init done. 接下来: aimail install(激活系统并绑定平台)")
        return 0

    # 远程网关 → bridge push:二进制 + 骨架配置(首次 install 补 key 并启动)
    env = dict(os.environ)
    env["GATEWAY_URL"] = gw
    env.setdefault("WEBHOOK_MODE", "bridge")
    r = subprocess.call([sys.executable, str(SCRIPTS_DIR / "deploy_bridge.py"),
                         "--init"], env=env)
    if r != 0:
        _warn(f"bridge init exit {r}")
        return r
    print("  init done. 接下来: aimail install(激活系统,首次将补齐 bridge key 并启动)")
    return 0


def _write_pi_pointer(sid: str) -> None:
    """写 ~/.pi/.agentmail {system_id, email}(与 openclaw pointer 同构)。"""
    try:
        load_core()
        from aimail_base import email_for_agent  # noqa: E402
    except Exception:
        return
    cfg_path = SYSTEMS_DIR / sid / "agentmail_gateway.json"
    if not cfg_path.is_file():
        return
    try:
        cfg = json.loads(cfg_path.read_text())
    except Exception:
        return
    email = email_for_agent("pi", cfg.get("domain", ""), cfg.get("system_name", ""))
    if not email:
        return
    ptr = Path.home() / ".pi" / ".agentmail"
    try:
        ptr.parent.mkdir(parents=True, exist_ok=True)
        ptr.write_text(json.dumps({"system_id": sid, "email": email}))
        _ok(f"pi pointer written {ptr}")
    except Exception as e:
        _warn(f"pi pointer write failed: {e}")


def cmd_install(args) -> int:
    """安装:集成脚本到 check 前的全部步骤(非交互化)。"""
    system_home = Path(args.home).expanduser() if args.home else Path()
    if not args.home:
        _fail("install 需要 --home(系统 home/平台根)")
    if not system_home.exists():
        _fail(f"home 目录不存在: {system_home}")
    platform = resolve_platform(system_home)
    if not platform:
        _fail(f"无法确定平台:{system_home} 目录无特征且无 aimail 指针")
    print(f"  install platform={platform} system_home={system_home}")

    # 1) 激活/复用系统 → setup_system.py(env 契约);参数优先,缺失从 .env 取
    load_core()
    from gateway_api import load_gateway_config
    env = dict(os.environ)
    gw_url = args.gateway_url or _env_val("AIMAIL_URL", "https://amail.token.tm")
    sys_name = args.system_name or _env_val("AIMAIL_SYSTEM_NAME")
    manager = args.manager or _env_val("AIMAIL_MANAGER_ADDRESS")
    prod_code = args.product_code or _env_val("AIMAIL_PRODUCT_CODE")
    adm_key = args.admin_key or _env_val("AIMAIL_ADMIN_KEY")
    want_domain = args.domain or _env_val("AIMAIL_DOMAIN")
    env["INTEGRATE_GATEWAY_URL"] = gw_url
    env["INTEGRATE_SYSTEM_ID"] = args.system_id or ""
    env["INTEGRATE_SYSTEM_NAME"] = sys_name
    env["INTEGRATE_SYSTEM_HOME"] = str(system_home)
    env["INTEGRATE_MANAGER_ADDRESS"] = manager
    env["INTEGRATE_AIMAIL_DOMAIN"] = want_domain
    env["INTEGRATE_SAVE_SNAPSHOTS"] = (
        "true" if _env_val("AIMAIL_SAVE_SNAPSHOTS", "no").lower() in ("yes", "true", "1") else "false")
    env["INTEGRATE_WEBHOOK_HOST"] = _env_val("AIMAIL_WEBHOOK_HOST")
    if prod_code:
        env["INTEGRATE_USE_PRODUCT_CODE"] = "true"
        env["INTEGRATE_PRODUCT_CODE"] = prod_code
    elif adm_key:
        env["INTEGRATE_ADMIN_KEY"] = adm_key
    # 无显式凭据 → 从已有配置/指针复用
    elif args.system_id:
        cfg = load_gateway_config(args.system_id)
        if cfg and cfg.get("admin_key"):
            env["INTEGRATE_ADMIN_KEY"] = cfg["admin_key"]
            env["INTEGRATE_SYSTEM_ID"] = args.system_id

    try:
        out = subprocess.check_output(
            [sys.executable, str(SCRIPTS_DIR / "setup_system.py")],
            env=env, text=True, stderr=subprocess.STDOUT)
    except subprocess.CalledProcessError as e:
        _fail(f"setup_system 失败: {(e.output or '').strip()[-400:]}")
    _ok("system configured")
    # 解析激活生成的 system_id(新系统路径 id 由服务器分配)
    sid2 = args.system_id or ""
    for line in out.splitlines():
        if line.startswith("__ERROR__"):
            _fail(line[len("__ERROR__"):].strip())
    try:
        data = json.loads(out)
        sid2 = data.get("system_id") or sid2
    except Exception:
        pass
    if sid2 and sid2 != (args.system_id or ""):
        env["INTEGRATE_SYSTEM_ID"] = sid2
        _ok(f"system_id: {sid2}")

    # 1b) domain 预置/创建:AIMAIL_DOMAIN 指定且系统缺失时主动创建
    if want_domain and sid2:
        load_core()
        try:
            from aimail_tools import _GatewayClient
            client = _GatewayClient(gw_url, env.get("INTEGRATE_ADMIN_KEY") or "")
            existing = client.list_system_domains(sid2)
            if isinstance(existing, list):
                if any((d.get("domain") or "").lower() == want_domain.lower() for d in existing):
                    _ok(f"domain present: {want_domain}")
                else:
                    body = {"id": f"d{int(time.time())}", "domain": want_domain}
                    res = client._request("POST", f"/api/v1/admin/systems/{sid2}/domains", body=body)
                    if isinstance(res, dict) and res.get("error"):
                        _warn(f"domain create failed: {res.get('error')} {res.get('detail') or ''}".strip())
                    else:
                        _ok(f"domain created: {want_domain}")
            else:
                _warn(f"domain check failed: {existing}")
        except Exception as e:
            _warn(f"domain ensure skipped: {e}")

    # 2) 部署 bridge(单实例多系统合并;本地直连网关无需桥)
    if _is_local_gateway(gw_url):
        _ok("bridge: 本地网关直连模式,无需 bridge")
    else:
        env2 = dict(os.environ)
        env2["GATEWAY_URL"] = env["INTEGRATE_GATEWAY_URL"]
        env2["ADMIN_KEY"] = env.get("INTEGRATE_ADMIN_KEY", "")
        env2["SYSTEM_ID"] = env["INTEGRATE_SYSTEM_ID"]
        r = subprocess.call([sys.executable, str(SCRIPTS_DIR / "deploy_bridge.py")], env=env2)
        _ok("bridge deployed" if r == 0 else "bridge: see warnings")

    # 3) 平台适配
    if platform == "hermes":
        # SDK 自足安装(pysdk:pip aimail 运行时 + patch/toolsets/register/资源)。
        # venv pip aimail 是 webhook 运行时载荷,须就位。
        venv_py = system_home / "hermes-agent" / "venv" / "bin" / "python"
        if venv_py.is_file():
            r = subprocess.call(
                [str(venv_py), "-m", "pip", "install", "-q", "aimail"],
                env=dict(os.environ))
            if r != 0:
                _warn(f"venv pip install aimail exit {r}(webhook 适配运行时缺失?)")
        rc = _sdk_install("hermes", system_home, env.get("INTEGRATE_SYSTEM_ID", ""))
        _ok("hermes SDK install done(重启 hermes gateway 生效)" if rc == 0
            else "hermes SDK install: see warnings")
    elif platform == "openclaw":
        env3 = dict(os.environ)
        env3["AIMAIL_SYSTEM_ID"] = env.get("INTEGRATE_SYSTEM_ID", "")
        r = subprocess.call([sys.executable, str(SCRIPTS_DIR.parent / "bin" / "register_agent.py"),
                             "--all", "--system-id", env.get("INTEGRATE_SYSTEM_ID", "")],
                            env=env3)
        if r == 0:
            # TS 插件(openclaw-aimail)承载工具+入站端点;Python MCP 已退役。
            for sh in ("install-skill.sh",):
                subprocess.call(["bash", str(SCRIPTS_DIR / "openclaw" / sh)], env=env3)
        _ok("openclaw agents registered + skill installed")
        print("  openclaw: TS 插件安装 = npm pack openclaw-aimail/ 后 "
              "`openclaw plugins install npm-pack:<tgz> --force` + 重启 gateway")
    elif platform == "pi":
        # pi:注册 pi agent 地址 + 写 ~/.pi/.agentmail 指针(与 openclaw 同构)。
        # 扩展(pi-aimail)由宿主命令安装;资源自触发。
        env3 = dict(os.environ)
        env3["AIMAIL_SYSTEM_ID"] = env.get("INTEGRATE_SYSTEM_ID", "")
        r = subprocess.call([sys.executable, str(SCRIPTS_DIR.parent / "bin" / "register_agent.py"),
                             "--agent", "pi", "--system-id", env.get("INTEGRATE_SYSTEM_ID", ""),
                             "--manager", manager or _env_val("AIMAIL_MANAGER_ADDRESS")],
                            env=env3)
        if r == 0:
            _write_pi_pointer(env.get("INTEGRATE_SYSTEM_ID", ""))
            _ok("pi agent registered + pointer written")
        print("  pi: 扩展安装 = pi install npm:pi-aimail(宿主命令)+ 重启")
    else:  # deerflow
        # SDK 自足安装:register/reconcile + app.py patch + 运行时 bundle + 资源
        rc = _sdk_install("deerflow", system_home, env.get("INTEGRATE_SYSTEM_ID", ""))
        _ok("deerflow SDK install done" if rc == 0 else "deerflow SDK install: see warnings")
        # skill/mcp 宿主机制仍由 CLI 装配
        env3 = dict(os.environ)
        env3["AIMAIL_SYSTEM_ID"] = env.get("INTEGRATE_SYSTEM_ID", "")
