{
  "name": "dsh-aimail",
  "description": "AIMail plugin for dsh \u2014 install via: dsh plugin --profile web add dsh-aimail",
  "version": "0.1.55",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/metercai/aimail"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mail-service": {
      "types": "./dist/mail-service.d.ts",
      "default": "./dist/mail-service.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./inbound": {
      "types": "./dist/inbound.d.ts",
      "default": "./dist/inbound.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "cordis.patch.yml",
    "resources/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "GPL-3.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1 || ^0.2.0-rc.2"
  },
  "dependencies": {
    "@aimail/mail-core": "workspace:^",
    "@aimail/mail": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "keywords": [
    "aimail",
    "agent-mail",
    "dsh",
    "deepseek-harness",
    "plugin",
    "email"
  ],
  "scripts": {
    "prepack": "node ../mail-core/scripts/stage-resources.mjs --dest ./resources"
  }
}
