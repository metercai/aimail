{
  "id": "agent-aimail",
  "name": "AIMail",
  "description": "AIMail email capability for OpenClaw: mail/board tools plus in-agent aimail_address/aimail_system activation.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "enabledByDefault": false,
  "activation": {
    "onStartup": true,
    "onCapabilities": [
      "tool"
    ]
  },
  "contracts": {
    "tools": [
      "send_mail",
      "manage_contacts",
      "contact_profile",
      "set_contact_profile",
      "email_summary",
      "set_email_summary",
      "search_mail",
      "board_status",
      "board_task_list",
      "board_task_show",
      "board_heartbeat",
      "board_members",
      "board_roles",
      "role_calibrator",
      "aimail_address",
      "aimail_system"
    ]
  }
}
