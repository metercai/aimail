{
  "name": "agent-aimail",
  "description": "AIMail agent mail SDK — single package for OpenClaw / dsh (DeepSeek Harness) / Pi hosts. Host detection at startup, per-host activation. 15 mail tools, inbound delivery (HMAC), board/skill resources, agent-level addressing.",
  "version": "0.2.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/metercai/aimail"
  },
  "type": "module",
  "main": "./dist/hosts/index.js",
  "types": "./dist/hosts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/hosts/index.d.ts",
      "default": "./dist/hosts/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./mail": {
      "types": "./dist/mail/index.d.ts",
      "default": "./dist/mail/index.js"
    },
    "./openclaw": {
      "types": "./dist/openclaw/index.d.ts",
      "default": "./dist/openclaw/index.js"
    },
    "./dsh": {
      "types": "./dist/dsh/index.d.ts",
      "default": "./dist/dsh/index.js"
    },
    "./pi": {
      "types": "./dist/pi/index.d.ts",
      "default": "./dist/pi/index.js"
    },
    "./package.json": "./package.json",
    "./mail-service": {
      "types": "./dist/dsh/mail-service.d.ts",
      "default": "./dist/dsh/mail-service.js"
    },
    "./tools": {
      "types": "./dist/dsh/tools.d.ts",
      "default": "./dist/dsh/tools.js"
    },
    "./inbound": {
      "types": "./dist/dsh/inbound.d.ts",
      "default": "./dist/dsh/inbound.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "prepack": "npm run build && node scripts/stage-resources.mjs --dest ./resources"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "openclaw.plugin.json",
    "cordis.patch.yml",
    "resources/**",
    "README.md"
  ],
  "dependencies": {
    "typebox": "^1.3.6"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6 || ^0.2.0-rc.2 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.2.0-rc.2 || ^0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.2 || ^0.2.1-rc.1",
    "@earendil-works/pi-coding-agent": ">=1.1.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./dist/pi/index.js"
    ]
  },
  "openclaw": {
    "extensions": [
      "./dist/openclaw/index.js"
    ],
    "install": {
      "npmSpec": "agent-aimail",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.7.1"
    },
    "compat": {
      "pluginApi": ">=2026.7.1"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "keywords": [
    "aimail",
    "agent-mail",
    "openclaw",
    "dsh",
    "deepseek-harness",
    "pi",
    "plugin",
    "email"
  ],
  "devDependencies": {
    "openclaw": "2026.7.1-2",
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
