# aimail-bridge configuration example
#
# Copy this file to aimail_bridge.toml and edit to match your setup.
# Run: ./aimail-bridge -c aimail_bridge.toml

# ── Top-level ─────────────────────────────────────────────────────
mode = "push"                        # "push" (bridge receives webhooks) or
                                     # "pull" (bridge polls the gateway)
bind = "0.0.0.0:38080"               # Listen address (admin API + push webhooks)

# TLS — choose ONE of the three options below:
#   1. hostname (domain) + no static certs  → ACME auto-cert (Let's Encrypt)
#   2. hostname (domain) + tls_cert/tls_key → static certificate
#   3. no hostname or IP hostname           → plain HTTP (no TLS)
# hostname = "bridge.example.com"    # Public domain name (enables TLS)
# tls_cert = "/etc/ssl/bridge.crt"   # Static TLS certificate (PEM)
# tls_key  = "/etc/ssl/bridge.key"   # Static TLS private key (PEM)
# acme_email = "admin@example.com"   # ACME account contact (expiry notices)
# acme_challenge_path = "/var/www/"  # HTTP-01 challenge dir for an external
                                     # web server; unset → bridge listens on
                                     # port 80 itself for the challenge

# Admin API IP whitelist (GET /health, /api/v1/*).
# Default: localhost only. Requests from other IPs get 403.
admin_allowed_ips = ["127.0.0.1", "::1"]

# Headers passed through to the gateway.
# Primary: x-aimail-email (required for push deliveries since v0.7.0 —
# missing header returns 400). The legacy alias x-amail-email is also accepted.
# Others: x-webhook-signature, x-mailrelay-timestamp, content-type.
# forward_headers = ["x-aimail-email", "x-webhook-signature", "x-mailrelay-timestamp", "content-type"]

# Logging
# Default with NO [logging] section: logs go to /var/log/aimail-bridge.log —
# non-root startup fails (panic) because that path is not writable.
# Declare [logging] WITHOUT `file` to log to stdout instead.
# [logging]
# level = "info"                       # log level (default: "info")
# file = "/tmp/aimail-bridge.log"      # log file path; unset → stdout

# ── Pull mode (bridge polls gateway outbound) ─────────────────────
#
# Single system (legacy flat fields):
# [pull]
# amail_url = "http://gateway.example.com:38080"  # Gateway HTTP API URL
# admin_key = "sk-..."                            # System-scope API key (must
#                                                  # match the system_id below —
#                                                  # pending deliveries are
#                                                  # filtered by the key's system)
# system_id = "admin"                             # System ID (default: "admin")
# poll_interval_sec = 10                          # Poll interval seconds (default: 10)

# Multi-system (one bridge, several systems — the production shape).
# Each entry pulls its own system's pending deliveries with its own key.
# amail_url may omit the scheme ("127.0.0.1:38080" → http:// is added).
# [pull]
# systems = [
#   { amail_url = "https://amail.example.com", admin_key = "sk-aaa", system_id = "shared-token-aaaaaaaa", poll_interval_sec = 2 },
#   { amail_url = "https://amail.example.com", admin_key = "sk-bbb", system_id = "shared-token-bbbbbbbb", poll_interval_sec = 2 },
# ]

# ── Push mode (bridge receives external POSTs) ────────────────────
# [push]
# allowed_ips = ["10.0.0.0/8", "192.168.1.1"]  # IP allowlist, empty = allow all (default: [])
# blacklist_ips = ["1.2.3.4", "10.0.0.0/8"]    # permanently blocked IPs/CIDRs (default: [])
# rate_limit = 30                              # req/sec per source IP, 0 = disabled (default: 30)
# body_limit_mb = 20                           # max request body size in MB (default: 20)

# Virtual host sites (optional, push mode only)
# [[push.sites]]
# domain = "www.example.com"
# root = "/var/www/example"                  # static site directory
#
# [[push.sites]]
# domain = "api.example.com"
# proxy = "127.0.0.1:3000"                   # reverse proxy target
#
# [[push.sites]]
# domain = "old.example.com"
# redirect = "https://www.example.com"       # 308 redirect URL
