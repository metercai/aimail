{
  "name": "dsh-amail",
  "description": "AgentMail plugin for dsh — install via: dsh plugin --profile web add dsh-amail",
  "version": "0.1.0-rc.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metercai/dsh-agentmail.git",
    "directory": "packages/agentmail"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "GPL-3.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@meterwei/mail-core": "^0.1.0-rc.6",
    "@meterwei/mail": "^0.1.0-rc.6",
    "@meterwei/tool-mail": "^0.1.0-rc.6",
    "@meterwei/mail-inbound": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
