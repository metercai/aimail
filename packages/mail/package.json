{
  "name": "@aimail/mail",
  "description": "AgentMail platform-neutral config resolution: sessionId/email/recipient → agentmail.json → AgentConfig (pure functions, no framework deps).",
  "version": "0.1.0-rc.9",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metercai/aimail-sdk-ts.git",
    "directory": "packages/mail"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {},
  "dependencies": {
    "@aimail/mail-core": "workspace:^"
  },
  "devDependencies": {}
}
