{
  "name": "openclaw-aimail",
  "description": "AgentMail plugin for OpenClaw: 12 mail tools (MAIL_TOOLS), inbound delivery (HMAC + preprocess chain), register/deregister/status commands.",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metercai/aimail-sdk-ts.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "openclaw.plugin.json",
    "README.md"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "install": {
      "npmSpec": "openclaw-aimail",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.7.1"
    },
    "compat": {
      "pluginApi": ">=2026.7.1"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@aimail/mail": "0.1.0-rc.10",
    "@aimail/mail-core": "0.1.0-rc.10",
    "typebox": "1.3.6"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "openclaw": "2026.7.1-2",
    "typescript": "^7.0.2"
  }
}
