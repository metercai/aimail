{
  "name": "openclaw-aimail",
  "description": "AIMail plugin for OpenClaw: 12 mail tools (MAIL_TOOLS), inbound delivery (HMAC + preprocess chain), register/deregister/status commands.",
  "version": "0.1.0-rc.8",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/metercai/aimail-sdk-ts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "bundleDependencies": [
    "@aimail/mail",
    "@aimail/mail-core"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "openclaw-aimail",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.7.1"
    },
    "compat": {
      "pluginApi": ">=2026.7.1"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@aimail/mail": "workspace:^",
    "@aimail/mail-core": "workspace:^",
    "typebox": "^1.3.6"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "openclaw": "2026.7.1-2",
    "typescript": "^7.0.2"
  }
}
