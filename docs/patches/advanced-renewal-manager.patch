+/// POST /api/v1/public/activation-code/preflight {code}
+/// Returns metadata WITHOUT consuming the code (agent B2 detection).
+pub async fn activation_code_preflight(
+    State(state): State<AdvancedState>,
+    Json(req): Json<serde_json::Value>,
+) -> Json<serde_json::Value> {
+    let code = req.get("code").and_then(|v| v.as_str()).unwrap_or("").trim();
+    if code.is_empty() {
+        return Json(serde_json::json!({"valid": false, "error": "code is required"}));
+    }
+    let record = state
+        .storage
+        .find_activation_code_by_hash(&sha256_hex(code))
+        .await
+        .ok()
+        .flatten();
+    let Some(c) = record else {
+        return Json(serde_json::json!({"valid": false, "error": "unknown activation code"}));
+    };
+    let expired = c
+        .expires_at
+        .as_deref()
+        .map(|e| e < crate::advanced::storage::expiry_millis(&chrono::Utc::now()).as_str())
+        .unwrap_or(false);
+    let sid = c.system_id.unwrap_or_default();
+    let scope = if sid.starts_with("shared_") || sid.starts_with("shared-") { "shared" } else { "system" };
+    Json(serde_json::json!({
+        "valid": c.claimed == 0 && c.is_frozen == 0 && !expired,
+        "code_type": c.code_type,
+        "scope": scope,
+        "system_id": sid,
+        "domain": c.domain.unwrap_or_default(),
+        "system_name": "",
+        "email_address": c.email_address.unwrap_or_default(),
+        "applicant_email": c.applicant_email.unwrap_or_default(),
+        "claimed": c.claimed != 0,
+        "is_frozen": c.is_frozen != 0,
+        "is_shipped": c.is_shipped != 0,
+        "expires_at": c.expires_at,
+        "error": if c.claimed != 0 { "already claimed" } else if expired { "expired" } else { "" },
+    }))
+}
+
