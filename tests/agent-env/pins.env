# pins.env — version pins (the testing start point must be reproducible).
#
# Single maintenance point: tests and the image build only READ this file. To move the
# environment forward, run update-pins.sh deliberately (it rewrites this file) — never
# from a gate. Rationale: a test run's environment must be the same every time; "is it
# the latest?" is a maintenance question, not a test-time question.
#
#   base images : pinned by digest -> a rebuild cannot silently pick up a new base
#   agents we install (npm / official installer) : pinned to an exact version / commit
#   deerflow    : built from source locally, pinned by <commit> tag (see its own builder)

# ── L2 vs L3 doctrine (architectural, owner-ruled 2026-11-23) ───────────────────────
# 1. L2 tests the CURRENT DEV build; L3 tests the PUBLISHED latest public SDK.
# 2. L2 pre-installs the dev build; L3 simulates a user: the agent downloads and
#    installs the SDK during the journey (the install itself is a test point).
# 3. L2 is the broad SDK functional suite; L3 is the closed-loop regression:
#    get code -> paste prompt -> install SDK -> activate -> address-code bind ->
#    welcome mail -> identity card + signature verification.
# 4. L2 covers the adapted agents on THIS machine's OS+CPU only; L3 uses dsh (tssdk)
#    across different OS+CPU targets. L3 is dsh-only: hermes (pysdk) is not migrated
#    to SSE-V2 and its CLI install path is retired ⇒ SKIP_LEGACY, never green.
# 5. BOTH layers test the SDK against the PUBLISHED latest gateway binary. A
#    gateway change must be fixed, gated and released FIRST, then the SDK re-run.

# ── published gateway (both L2 and L3 read this; update only via update-pins.sh) ────
# Key names must be shell-safe identifiers: this file is *sourced* (verify.sh, prepare.sh,
# host-images.yml, run-l2-dsh-real-host.sh). A dash in a key made bash try to execute the
# line ('GATEWAY_SHA256_linux-amd64=…: command not found'), which under `set -e` broke the
# host-image build and polluted every L3 log. Platform is spelled with '_' here; grep
# consumers translate ('linux-amd64' → 'linux_amd64').
GATEWAY_VERSION=v1.0.17
GATEWAY_SHA256_linux_amd64=7dd8dba397f2433255718ae5802e8d75c16bb7c4def715659f40b85240e10827
GATEWAY_SHA256_linux_arm64=690a289a833ceef0f95e85ddbc9dfa269df44706541c7ae89e508ccbfbba48cd
GATEWAY_SHA256_macos_arm64=de2ed2c79670e593a16c8bf3a01b26b1f447ce0c1732a3e6575b7fa8d3b66703
GATEWAY_SHA256_windows_amd64=b387d1d5220b409f5bfcfd7b98d56742885ecb06333857cc542b3540cf64db7a

# ── base images ─────────────────────────────────────────────────────────────────────
# <repo>:<tag>@<digest> — the tag documents where it came from, the digest is what is
# actually enforced (a rebuild cannot silently pick up a different base).
BASE_HERMES=nousresearch/hermes-agent:latest@sha256:d6746a084e9341baada483e3d6210444d3c1aeb7c130f0915150065fb2851459
BASE_OPENCLAW=ghcr.io/openclaw/openclaw:latest@sha256:9c74476e3e79b5a1595fd5cf904286eaba3471c10c640aaa9a361a89b41d0882
BASE_NODE=nikolaik/python-nodejs:python3.12-nodejs22@sha256:2bc76406cf6a7ac351c0f96de3bc37fe1c4950d283b29cc302cfabf845416488
BASE_DEERFLOW=deer-flow-gateway:src-fc26204d

# ── agents/tools prepare.sh installs (exact versions) ───────────────────────────────
DSH_VERSION=0.2.2-rc.1
PI_VERSION=1.5.2
PNPM_VERSION=12.21.0

# ── deer-flow（从源码重建，pin = 源码 rev；基底镜像不能拉 registry，见重建脚本头）────
# BASE_DEERFLOW 由 tests/agent-env/docker/rebuild-deerflow-base.sh 产出，
# Dockerfile.deerflow / host-images.yml 必须引用同一个值（`--check` 校验三方对齐）。
DEERFLOW_REV=fc26204d

# ── host install (L3): the official hermes installer, pinned to a commit ────────────
HERMES_COMMIT=9dbaa77c4c5b6391510832602f841bc95d390b22
HERMES_HOST_VERSION=0.23.2

# ── agents that come from the base image (version observed, base digest pinned) ─────
HERMES_IMAGE_VERSION=0.23.2
OPENCLAW_VERSION=2026.11.5
