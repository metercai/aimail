# pins.env — version pins (the testing start point must be reproducible).
#
# Single maintenance point: tests and the image build only READ this file. To move the
# environment forward, run update-pins.sh deliberately (it rewrites this file) — never
# from a gate. Rationale: a test run's environment must be the same every time; "is it
# the latest?" is a maintenance question, not a test-time question.
#
#   base images : pinned by digest -> a rebuild cannot silently pick up a new base
#   agents we install (npm / official installer) : pinned to an exact version / commit
#   deerflow    : built from source locally, pinned by <commit> tag (see its own builder)

# ── base images ─────────────────────────────────────────────────────────────────────
# <repo>:<tag>@<digest> — the tag documents where it came from, the digest is what is
# actually enforced (a rebuild cannot silently pick up a different base).
BASE_HERMES=nousresearch/hermes-agent:latest@sha256:36099926da316742423544e055d4734777105ffe6341873af5459b957d0c2919
BASE_OPENCLAW=ghcr.io/openclaw/openclaw:latest@sha256:f40d1e66fd14d8c5b49c832f4100f83b53fdc01f5108f7db11de38fd0ee6dbe5
BASE_NODE=nikolaik/python-nodejs:python3.12-nodejs22@sha256:f83f50e93ae66276a3ac912b7402f7121ad7fd4d0e1e049c06c58011f590677c
BASE_DEERFLOW=deer-flow-gateway:src-fc26204d

# ── agents/tools prepare.sh installs (exact versions) ───────────────────────────────
DSH_VERSION=0.2.1-rc.2
PI_VERSION=1.3.0
PNPM_VERSION=12.14.0

# ── host install (L3): the official hermes installer, pinned to a commit ────────────
HERMES_COMMIT=0b10b9f8155a7ecadd8c540b87712c791b5c8ac9
HERMES_HOST_VERSION=0.22.2

# ── agents that come from the base image (version observed, base digest pinned) ─────
HERMES_IMAGE_VERSION=0.22.2
OPENCLAW_VERSION=2026.10.5
