# agent-env/docker/Dockerfile.pi — pi test host image (environment prep only).
#
# Pure native: the pi-aimail extension is installed by the test itself.
# This layer prepares the official pi (npm) + its base environment + LLM config.
ARG BASE_IMG=nikolaik/python-nodejs:python3.12-nodejs22
FROM ${BASE_IMG}

ARG LLM_BASE_URL=http://127.0.0.1:8000/v1
ARG LLM_MODEL=Qwen3.8-27B-UD-Q4_K_M

COPY agent-env /opt/agent-env

# pnpm's built-in release-age gate (minimumReleaseAge) — see Dockerfile.dsh for why the
# env form is the one that takes effect.
ENV PNPM_CONFIG_MINIMUM_RELEASE_AGE=0

RUN bash /opt/agent-env/prepare.sh pi --home /root/.pi \
      --llm-url "$LLM_BASE_URL" --llm-model "$LLM_MODEL" --no-verify

COPY extras /opt/regression
RUN [ -d /opt/regression ] && chmod +x /opt/regression/*.sh 2>/dev/null || true

RUN LLM_CONFIG_PRE_INSTALL=1 bash /opt/agent-env/verify.sh pi --home /root/.pi \
      --llm-url "$LLM_BASE_URL" --llm-model "$LLM_MODEL" --offline

CMD ["sleep", "infinity"]
