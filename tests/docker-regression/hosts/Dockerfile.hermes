# hermes 宿主测试镜像 — 官方 nousresearch/hermes-agent + aimail SDK(pysdk 注入)
#
# 官方镜像(Hub:nousresearch/hermes-agent,debian:13.4 基础,s6-overlay 服务化):
#   hermes CLI   = /opt/hermes/bin/hermes(privilege-drop shim)
#   hermes 源码树 = /opt/hermes(v0.21.x,venv 在 .venv)
#   数据目录     = /opt/data(官方文档:docker -v ~/.hermes:/opt/data)
#   HOME        = /root(容器内 root)
#
# 方案 A 语义:被测物 = hermes 平台 + pysdk;网关/bridge 在宿主。
ARG BASE_IMG=nousresearch/hermes-agent:latest
FROM ${BASE_IMG}

# pysdk + CLI(仓库挂载/或打包注入;registry 版本经 pip)
ARG PKG_SOURCE=repo
ARG VERSION=0.1.11
COPY pyproject.toml /opt/aimail-src/pyproject.toml
COPY pysdk /opt/aimail-src/pysdk
COPY cli /opt/aimail-src/cli
RUN if [ "$PKG_SOURCE" = "registry" ]; then \
      pip install -q --break-system-packages "aimailsdk==${VERSION}"; \
    fi

# hermes 平台侧不需要预装 SDK 包——install/reset 由宿主驱动;镜像内只保证
# hermes CLI 可用 + python3+pip 就绪(SDK 经挂载注入)。
RUN /opt/hermes/bin/hermes --version 2>&1 | head -1

COPY tests/docker-regression/hosts/run-host-regression-hermes.sh /opt/regression/
RUN chmod +x /opt/regression/*.sh
CMD ["bash", "/opt/regression/run-host-regression-hermes.sh"]
