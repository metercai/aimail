# dsh 宿主测试镜像 — nikolaik 基础 + 官方 @deepseek-ai/dsh + aimail SDK
ARG BASE_IMG=nikolaik/docker-python-nodejs:python3.12-nodejs22-slim
FROM ${BASE_IMG}

# 官方 dsh(无官方镜像;npm 包即官方发布物)。dsh 运行时=headless 配置最小化
RUN npm install -g @deepseek-ai/dsh --no-audit --no-fund 2>/dev/null || npm install -g @deepseek-ai/dsh
RUN dsh --version 2>/dev/null || true

# aimail 共享库(注册链经 register-cli 直跑;Python 侧工具链)
ARG PKG_SOURCE=registry
ARG VERSION=0.1.11
RUN if [ "$PKG_SOURCE" = "registry" ]; then \
      pip install -q --break-system-packages aimailsdk==${VERSION} || pip install -q aimailsdk==${VERSION}; \
    fi

# dsh-aimail(含 register-cli node 入口)按宿主 profile 布局
RUN mkdir -p /root/.dsh/profiles/web/node_modules && \
    npm install --prefix /tmp/aimail-ts --no-audit --no-fund \
      dsh-aimail@${VERSION} @aimail/mail-core@${VERSION} @aimail/mail@${VERSION} >/dev/null 2>&1; \
    cp -r /tmp/aimail-ts/node_modules/* /root/.dsh/profiles/web/node_modules/ && \
    rm -rf /tmp/aimail-ts && \
    ls /root/.dsh/profiles/web/node_modules/dsh-aimail/lib/register-cli.js >/dev/null && echo "register-cli 就位"

COPY run-host-regression.sh /opt/regression/
RUN chmod +x /opt/regression/*.sh
CMD ["bash", "/opt/regression/run-host-regression.sh"]
